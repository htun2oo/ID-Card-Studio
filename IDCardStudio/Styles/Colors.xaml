<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Application Color Brushes (ပရောဂျက်တစ်ဝှမ်း သုံးမည့် အရောင်များနှင့် Brushes များ) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="#ABADB3"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#E5F3FF"/>
    
</ResourceDictionary>
