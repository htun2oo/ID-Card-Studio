<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer Clone" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen">
    
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Height="25">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Close Project"/>
                <Separator/>
                <MenuItem Header="_Save Project" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save Project _As..."/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t Fields" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy Fields" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste Fields" InputGestureText="Ctrl+V"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Front of Selected Card" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Back of Selected Card" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="_Insert">
                <MenuItem Header="_Text Field" InputGestureText="Ctrl+T"/>
                <MenuItem Header="_Photo Field" InputGestureText="Ctrl+J"/>
                <MenuItem Header="_Date Field" InputGestureText="Ctrl+D"/>
                <MenuItem Header="_Signature Field" InputGestureText="Ctrl+I"/>
                <Separator/>
                <MenuItem Header="_Bar Code Field"/>
                <MenuItem Header="_Magnetic Stripe Field"/>
            </MenuItem>
            <MenuItem Header="_Format"/>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Window"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <!-- Toolbar Bar -->
        <ToolBarTray DockPanel.Dock="Top" Background="#E5E5E5">
            <ToolBar>
                <Button Content="New" Click="NewProject_Click" ToolTip="New Project (Ctrl+N)"/>
                <Button Content="Open" ToolTip="Open Project (Ctrl+O)"/>
                <Button Content="Save" ToolTip="Save Project (Ctrl+S)"/>
                <Separator/>
                <Button Content="Cut"/>
                <Button Content="Copy"/>
                <Button Content="Paste"/>
                <Separator/>
                <ComboBox Width="75" SelectedIndex="0">
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="150%"/>
                    <ComboBoxItem Content="200%"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <StatusBarItem x:Name="StatusText" Content="For Help, press F1"/>
        </StatusBar>

        <!-- Main Workspace (MDI Designer Area) -->
        <Grid Background="#A0A0A0" x:Name="WorkspaceGrid">
            <!-- Dynamic Child Windows (Cards, Production Form, Report) will be rendered here -->
        </Grid>
    </DockPanel>
</Window>
