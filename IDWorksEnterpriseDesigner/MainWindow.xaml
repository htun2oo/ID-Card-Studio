<!-- 3. Report Window -->
<Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Report" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
            <ComboBox x:Name="ReportSizeComboBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0" Height="20" SelectionChanged="ReportSizeComboBox_SelectionChanged">
                <ComboBoxItem Content="A4 (21.0 x 29.7 cm)" Tag="A4" IsSelected="True"/>
                <ComboBoxItem Content="A5 (14.8 x 21.0 cm)" Tag="A5"/>
                <ComboBoxItem Content="B5 (17.6 x 25.0 cm)" Tag="B5"/>
                <ComboBoxItem Content="Letter (8.5 x 11 in)" Tag="Letter"/>
                <ComboBoxItem Content="Legal (8.5 x 14 in)" Tag="Legal"/>
            </ComboBox>
        </Grid>

        <Border Background="#CCCCCC" Padding="4">
            <Grid Background="#E6E6E6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                
                <!-- Report Top Horizontal Ruler (0 to 21 cm) -->
                <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                    <Canvas Background="Transparent" ClipToBounds="True">
                        <!-- 0 to 10 cm -->
                        <TextBlock Text="0" Canvas.Left="15" Canvas.Top="2" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                        <Line X1="17.8" Y1="17" X2="17.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="5" Canvas.Left="205" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                        <Line X1="206.8" Y1="17" X2="206.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="10" Canvas.Left="391" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                        <Line X1="395.8" Y1="17" X2="395.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                        <!-- 11 to 21 cm -->
                        <TextBlock Text="15" Canvas.Left="579" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                        <Line X1="584.8" Y1="17" X2="584.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="20" Canvas.Left="767" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                        <Line X1="773.8" Y1="17" X2="773.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                    </Canvas>
                </Border>

                <!-- Report Left Vertical Ruler (0 to 30 cm) -->
                <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                    <Canvas Background="Transparent" ClipToBounds="True">
                        <TextBlock Text="0" Canvas.Left="4" Canvas.Top="15" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                        <Line X1="17" Y1="13" X2="24" Y2="13" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="5" Canvas.Left="6" Canvas.Top="200" FontSize="9" Foreground="Black"/>
                        <Line X1="17" Y1="202.0" X2="24" Y2="202.0" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="10" Canvas.Left="4" Canvas.Top="388" FontSize="9" Foreground="Black"/>
                        <Line X1="17" Y1="391.0" X2="24" Y2="391.0" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="15" Canvas.Left="4" Canvas.Top="577" FontSize="9" Foreground="Black"/>
                        <Line X1="17" Y1="580.0" X2="24" Y2="580.0" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="20" Canvas.Left="4" Canvas.Top="766" FontSize="9" Foreground="Black"/>
                        <Line X1="17" Y1="769.0" X2="24" Y2="769.0" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="25" Canvas.Left="4" Canvas.Top="954" FontSize="9" Foreground="Black"/>
                        <Line X1="17" Y1="958.0" X2="24" Y2="958.0" Stroke="Black" StrokeThickness="1"/>
                        <TextBlock Text="30" Canvas.Left="4" Canvas.Top="1143" FontSize="9" Foreground="Black"/>
                        <Line X1="17" Y1="1147.0" X2="24" Y2="1147.0" Stroke="Black" StrokeThickness="1"/>
                    </Canvas>
                </Border>

                <!-- Report Document Border & Overlay Canvas (Default A4: 793.8 x 1122.6) -->
                <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17.8,13,0,0">
                        <Border x:Name="ReportDocumentBorder" Width="793.8" Height="1122.6" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                        <Canvas x:Name="ReportOverlayCanvas" Width="793.8" Height="1122.6" Background="Transparent"
                                MouseLeftButtonDown="ReportOverlayCanvas_MouseLeftButtonDown"
                                MouseMove="ReportOverlayCanvas_MouseMove"
                                MouseLeftButtonUp="ReportOverlayCanvas_MouseLeftButtonUp"
                                IsHitTestVisible="True"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Border>
