<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="690" Width="1012"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <!-- 1. File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" />
                <Separator x:Name="Sep1" Visibility="Collapsed" />
                <MenuItem x:Name="MenuCloseProject" Header="_Close Project" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProject" Header="_Save Project" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProjectAs" Header="Save Project _As..." Visibility="Collapsed" />
                <Separator x:Name="Sep2" Visibility="Collapsed" />
                <MenuItem x:Name="MenuProjectProperties" Header="Project _Properties..." Visibility="Collapsed" />
                <Separator x:Name="Sep3" Visibility="Collapsed" />
                <MenuItem x:Name="MenuPrintSampleCard" Header="_Print Sample Card..." Visibility="Collapsed" />
                <MenuItem x:Name="MenuPreviewSampleReport" Header="Pre_view Sample Report..." Visibility="Collapsed" />
                <MenuItem x:Name="MenuReportPageSetup" Header="Report Page Set_up..." Visibility="Collapsed" />
                <Separator x:Name="Sep4" Visibility="Collapsed" />
                <MenuItem x:Name="MenuDeleteProject" Header="_Delete Project..." Visibility="Collapsed" />
                <Separator />
                <MenuItem x:Name="MenuRecentFile" Header="Recent File" IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>

            <!-- 2. Edit Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuEdit" Header="_Edit" Visibility="Collapsed" />

            <!-- 3. View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True" />
                    <Separator />
                    <MenuItem Header="Large Toolbar Buttons" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Small Toolbar Buttons" IsCheckable="True" IsChecked="False" />
                </MenuItem>
                <MenuItem Header="Show Welcome on startup" IsCheckable="True" IsChecked="True" />
            </MenuItem>

            <!-- 4. Insert Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuInsert" Header="_Insert" Visibility="Collapsed" />

            <!-- 5. Format Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuFormat" Header="F_ormat" Visibility="Collapsed" />

            <!-- 6. Tools Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuTools" Header="_Tools" Visibility="Collapsed" />

            <!-- 7. Window Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuWindow" Header="_Window" Visibility="Collapsed" />

            <!-- 8. Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_Online Help..." InputGestureText="F1" />
                <Separator />
                <MenuItem Header="_About..." />
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area -->
        <Grid x:Name="MdiHostGrid" Background="#808080">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Window 1: Card View -->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#002D96" BorderThickness="3" Margin="2" Background="#D4D0C8">
                <DockPanel>
                    <!-- Classic Window Title Bar with Action Buttons -->
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="22">
                        <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,3,2">
                            <Button Content="-" Width="14" Height="14" FontSize="9" Padding="0,-3,0,0" Margin="1,0"/>
                            <Button Content="☐" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                            <Button Content="✕" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top Ruler with Ticks -->
                        <Canvas Grid.Row="0" Grid.Column="1" Height="22" Width="310" Background="#D4D0C8">
                            <Polyline Points="0,21 310,21" Stroke="Gray" StrokeThickness="1"/>
                            <!-- Ticks & Numbers -->
                            <TextBlock Text="1" Canvas.Left="35" Canvas.Top="0" FontSize="9"/>
                            <Line X1="38" Y1="12" X2="38" Y2="20" Stroke="Black"/>
                            <TextBlock Text="2" Canvas.Left="75" Canvas.Top="0" FontSize="9"/>
                            <Line X1="78" Y1="12" X2="78" Y2="20" Stroke="Black"/>
                            <TextBlock Text="3" Canvas.Left="115" Canvas.Top="0" FontSize="9"/>
                            <Line X1="118" Y1="12" X2="118" Y2="20" Stroke="Black"/>
                            <TextBlock Text="4" Canvas.Left="155" Canvas.Top="0" FontSize="9"/>
                            <Line X1="158" Y1="12" X2="158" Y2="20" Stroke="Black"/>
                            <TextBlock Text="5" Canvas.Left="195" Canvas.Top="0" FontSize="9"/>
                            <Line X1="198" Y1="12" X2="198" Y2="20" Stroke="Black"/>
                            <TextBlock Text="6" Canvas.Left="235" Canvas.Top="0" FontSize="9"/>
                            <Line X1="238" Y1="12" X2="238" Y2="20" Stroke="Black"/>
                            <TextBlock Text="7" Canvas.Left="275" Canvas.Top="0" FontSize="9"/>
                            <Line X1="278" Y1="12" X2="278" Y2="20" Stroke="Black"/>
                            <TextBlock Text="8" Canvas.Left="295" Canvas.Top="0" FontSize="9"/>
                            <Line X1="298" Y1="12" X2="298" Y2="20" Stroke="Black"/>
                        </Canvas>

                        <!-- Left Ruler with Ticks -->
                        <Canvas Grid.Row="1" Grid.Column="0" Width="22" Height="190" Background="#D4D0C8">
                            <Polyline Points="21,0 21,190" Stroke="Gray" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="2" Canvas.Top="25" FontSize="9"/>
                            <Line X1="12" Y1="30" X2="20" Y2="30" Stroke="Black"/>
                            <TextBlock Text="2" Canvas.Left="2" Canvas.Top="65" FontSize="9"/>
                            <Line X1="12" Y1="70" X2="20" Y2="70" Stroke="Black"/>
                            <TextBlock Text="3" Canvas.Left="2" Canvas.Top="105" FontSize="9"/>
                            <Line X1="12" Y1="110" X2="20" Y2="110" Stroke="Black"/>
                            <TextBlock Text="4" Canvas.Left="2" Canvas.Top="145" FontSize="9"/>
                            <Line X1="12" Y1="150" X2="20" Y2="150" Stroke="Black"/>
                            <TextBlock Text="5" Canvas.Left="2" Canvas.Top="175" FontSize="9"/>
                            <Line X1="12" Y1="180" X2="20" Y2="180" Stroke="Black"/>
                        </Canvas>

                        <!-- Card Surface -->
                        <Border Grid.Row="1" Grid.Column="1" Width="300" Height="180" Background="White" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas x:Name="CardFrontCanvas"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Window 2: Production Form -->
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="#002D96" BorderThickness="3" Margin="2" Background="White">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="22">
                        <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,3,2">
                            <Button Content="-" Width="14" Height="14" FontSize="9" Padding="0,-3,0,0" Margin="1,0"/>
                            <Button Content="☐" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                            <Button Content="✕" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Background="White"/>
                </DockPanel>
            </Border>

            <!-- Window 3: Card (back side) View -->
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#002D96" BorderThickness="3" Margin="2" Background="#D4D0C8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="22">
                        <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,3,2">
                            <Button Content="-" Width="14" Height="14" FontSize="9" Padding="0,-3,0,0" Margin="1,0"/>
                            <Button Content="☐" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                            <Button Content="✕" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="12,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top Ruler -->
                        <Canvas Grid.Row="0" Grid.Column="1" Height="22" Width="310" Background="#D4D0C8">
                            <Polyline Points="0,21 310,21" Stroke="Gray" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="35" Canvas.Top="0" FontSize="9"/>
                            <Line X1="38" Y1="12" X2="38" Y2="20" Stroke="Black"/>
                            <TextBlock Text="2" Canvas.Left="75" Canvas.Top="0" FontSize="9"/>
                            <Line X1="78" Y1="12" X2="78" Y2="20" Stroke="Black"/>
                            <TextBlock Text="3" Canvas.Left="115" Canvas.Top="0" FontSize="9"/>
                            <Line X1="118" Y1="12" X2="118" Y2="20" Stroke="Black"/>
                            <TextBlock Text="4" Canvas.Left="155" Canvas.Top="0" FontSize="9"/>
                            <Line X1="158" Y1="12" X2="158" Y2="20" Stroke="Black"/>
                            <TextBlock Text="5" Canvas.Left="195" Canvas.Top="0" FontSize="9"/>
                            <Line X1="198" Y1="12" X2="198" Y2="20" Stroke="Black"/>
                            <TextBlock Text="6" Canvas.Left="235" Canvas.Top="0" FontSize="9"/>
                            <Line X1="238" Y1="12" X2="238" Y2="20" Stroke="Black"/>
                            <TextBlock Text="7" Canvas.Left="275" Canvas.Top="0" FontSize="9"/>
                            <Line X1="278" Y1="12" X2="278" Y2="20" Stroke="Black"/>
                            <TextBlock Text="8" Canvas.Left="295" Canvas.Top="0" FontSize="9"/>
                            <Line X1="298" Y1="12" X2="298" Y2="20" Stroke="Black"/>
                        </Canvas>

                        <!-- Left Ruler -->
                        <Canvas Grid.Row="1" Grid.Column="0" Width="22" Height="190" Background="#D4D0C8">
                            <Polyline Points="21,0 21,190" Stroke="Gray" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="2" Canvas.Top="25" FontSize="9"/>
                            <Line X1="12" Y1="30" X2="20" Y2="30" Stroke="Black"/>
                            <TextBlock Text="2" Canvas.Left="2" Canvas.Top="65" FontSize="9"/>
                            <Line X1="12" Y1="70" X2="20" Y2="70" Stroke="Black"/>
                            <TextBlock Text="3" Canvas.Left="2" Canvas.Top="105" FontSize="9"/>
                            <Line X1="12" Y1="110" X2="20" Y2="110" Stroke="Black"/>
                            <TextBlock Text="4" Canvas.Left="2" Canvas.Top="145" FontSize="9"/>
                            <Line X1="12" Y1="150" X2="20" Y2="150" Stroke="Black"/>
                            <TextBlock Text="5" Canvas.Left="2" Canvas.Top="175" FontSize="9"/>
                            <Line X1="12" Y1="180" X2="20" Y2="180" Stroke="Black"/>
                        </Canvas>

                        <!-- Card Surface -->
                        <Border Grid.Row="1" Grid.Column="1" Width="300" Height="180" Background="White" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas x:Name="CardBackCanvas"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Window 4: Report View -->
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#002D96" BorderThickness="3" Margin="2" Background="#D4D0C8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="22">
                        <TextBlock Text="Report" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,3,2">
                            <Button Content="-" Width="14" Height="14" FontSize="9" Padding="0,-3,0,0" Margin="1,0"/>
                            <Button Content="☐" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                            <Button Content="✕" Width="14" Height="14" FontSize="8" Padding="0,-2,0,0" Margin="1,0"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Report Top Ruler -->
                            <Canvas Grid.Row="0" Grid.Column="1" Height="22" Width="850" Background="#D4D0C8">
                                <Polyline Points="0,21 850,21" Stroke="Gray" StrokeThickness="1"/>
                                <TextBlock Text="1" Canvas.Left="35" Canvas.Top="0" FontSize="9"/>
                                <Line X1="38" Y1="12" X2="38" Y2="20" Stroke="Black"/>
                                <TextBlock Text="2" Canvas.Left="75" Canvas.Top="0" FontSize="9"/>
                                <Line X1="78" Y1="12" X2="78" Y2="20" Stroke="Black"/>
                                <TextBlock Text="3" Canvas.Left="115" Canvas.Top="0" FontSize="9"/>
                                <Line X1="118" Y1="12" X2="118" Y2="20" Stroke="Black"/>
                                <TextBlock Text="4" Canvas.Left="155" Canvas.Top="0" FontSize="9"/>
                                <Line X1="158" Y1="12" X2="158" Y2="20" Stroke="Black"/>
                                <TextBlock Text="5" Canvas.Left="195" Canvas.Top="0" FontSize="9"/>
                                <Line X1="198" Y1="12" X2="198" Y2="20" Stroke="Black"/>
                                <TextBlock Text="6" Canvas.Left="235" Canvas.Top="0" FontSize="9"/>
                                <Line X1="238" Y1="12" X2="238" Y2="20" Stroke="Black"/>
                                <TextBlock Text="7" Canvas.Left="275" Canvas.Top="0" FontSize="9"/>
                                <Line X1="278" Y1="12" X2="278" Y2="20" Stroke="Black"/>
                                <TextBlock Text="8" Canvas.Left="315" Canvas.Top="0" FontSize="9"/>
                                <Line X1="318" Y1="12" X2="318" Y2="20" Stroke="Black"/>
                                <TextBlock Text="9" Canvas.Left="355" Canvas.Top="0" FontSize="9"/>
                                <Line X1="358" Y1="12" X2="358" Y2="20" Stroke="Black"/>
                                <TextBlock Text="10" Canvas.Left="395" Canvas.Top="0" FontSize="9"/>
                                <Line X1="398" Y1="12" X2="398" Y2="20" Stroke="Black"/>
                                <TextBlock Text="11" Canvas.Left="435" Canvas.Top="0" FontSize="9"/>
                                <Line X1="438" Y1="12" X2="438" Y2="20" Stroke="Black"/>
                                <TextBlock Text="12" Canvas.Left="475" Canvas.Top="0" FontSize="9"/>
                                <Line X1="478" Y1="12" X2="478" Y2="20" Stroke="Black"/>
                                <TextBlock Text="13" Canvas.Left="515" Canvas.Top="0" FontSize="9"/>
                                <Line X1="518" Y1="12" X2="518" Y2="20" Stroke="Black"/>
                                <TextBlock Text="14" Canvas.Left="555" Canvas.Top="0" FontSize="9"/>
                                <Line X1="558" Y1="12" X2="558" Y2="20" Stroke="Black"/>
                            </Canvas>

                            <!-- Report Left Ruler -->
                            <Canvas Grid.Row="1" Grid.Column="0" Width="22" Height="1000" Background="#D4D0C8">
                                <Polyline Points="21,0 21,1000" Stroke="Gray" StrokeThickness="1"/>
                                <TextBlock Text="1" Canvas.Left="2" Canvas.Top="25" FontSize="9"/>
                                <Line X1="12" Y1="30" X2="20" Y2="30" Stroke="Black"/>
                                <TextBlock Text="2" Canvas.Left="2" Canvas.Top="65" FontSize="9"/>
                                <Line X1="12" Y1="70" X2="20" Y2="70" Stroke="Black"/>
                                <TextBlock Text="3" Canvas.Left="2" Canvas.Top="105" FontSize="9"/>
                                <Line X1="12" Y1="110" X2="20" Y2="110" Stroke="Black"/>
                                <TextBlock Text="4" Canvas.Left="2" Canvas.Top="145" FontSize="9"/>
                                <Line X1="12" Y1="150" X2="20" Y2="150" Stroke="Black"/>
                                <TextBlock Text="5" Canvas.Left="2" Canvas.Top="185" FontSize="9"/>
                                <Line X1="12" Y1="190" X2="20" Y2="190" Stroke="Black"/>
                                <TextBlock Text="6" Canvas.Left="2" Canvas.Top="225" FontSize="9"/>
                                <Line X1="12" Y1="230" X2="20" Y2="230" Stroke="Black"/>
                            </Canvas>

                            <!-- Full Report Paper Surface -->
                            <Border Grid.Row="1" Grid.Column="1" Width="850" Height="1000" Background="White" BorderBrush="Black" BorderThickness="1">
                                <Canvas x:Name="ReportCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
