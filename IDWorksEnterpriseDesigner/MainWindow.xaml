                                            <Line X1="144.3" Y1="19" X2="144.3" Y2="24" Stroke="Black" StrokeThickness="0.75"/>
                                            <TextBlock Text="4" Canvas.Left="165.4" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                                            <Line X1="163.2" Y1="18" X2="163.2" Y2="24" Stroke="Black" StrokeThickness="1"/>
                                            <Line X1="182.1" Y1="19" X2="182.1" Y2="24" Stroke="Black" StrokeThickness="0.75"/>
                                            <TextBlock Text="5" Canvas.Left="203.2" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                                            <Line X1="201.0" Y1="18" X2="201.0" Y2="24" Stroke="Black" StrokeThickness="1"/>
