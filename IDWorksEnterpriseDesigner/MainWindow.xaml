<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="#A0A0A0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Workspace Area -->
            <RowDefinition Height="22"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Menu Bar (Initial State: File, View, Help Only) -->
        <Menu Grid.Row="0" Background="#F0F0F0" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New..." KeyGesture="Ctrl+N"/>
                <MenuItem Header="_Open..." KeyGesture="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toolbar" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help Topics" KeyGesture="F1"/>
                <Separator/>
                <MenuItem Header="_About Datacard ID Works Enterprise Designer..."/>
            </MenuItem>
        </Menu>

        <!-- 2. Classic Icon Toolbar -->
        <ToolBarTray Grid.Row="1" Background="#F0F0F0">
            <ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
                <!-- Group 1: Standard File Tools -->
                <Button ToolTip="New">
                    <Image Source="pack://application:,,,/Resources/Icons/new.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Open">
                    <Image Source="pack://application:,,,/Resources/Icons/open.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Save" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/save.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Save All" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/saveall.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Help">
                    <Image Source="pack://application:,,,/Resources/Icons/help.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>

                <Separator />

                <!-- Group 2: Edit Tools -->
                <Button ToolTip="Cut" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/cut.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Copy" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/copy.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Paste" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/paste.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>

                <Separator />

                <!-- Group 3: History Tools -->
                <Button ToolTip="Undo" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/undo.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>
                <Button ToolTip="Redo" IsEnabled="False">
                    <Image Source="pack://application:,,,/Resources/Icons/redo.png" Width="16" Height="16" ErrorTemplate="{x:Null}"/>
                </Button>

                <Separator />

                <!-- Group 4: Alignment & Layout Tools -->
                <Button ToolTip="Align Left" IsEnabled="False"/>
                <Button ToolTip="Align Center" IsEnabled="False"/>
                <Button ToolTip="Align Right" IsEnabled="False"/>

                <Separator />

                <!-- Group 5: Designer Options -->
                <Button ToolTip="Card Options" IsEnabled="False"/>
                <Button ToolTip="Production Options" IsEnabled="False"/>
                <Button ToolTip="Report Options" IsEnabled="False"/>

                <Separator />

                <!-- Group 6: Zoom Combo -->
                <ComboBox Width="65" SelectedIndex="3" IsEnabled="False" Margin="2,0">
                    <ComboBoxItem Content="25%"/>
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="150%"/>
                    <ComboBoxItem Content="200%"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <!-- 3. MDI Workspace Area (Gray Background) -->
        <Grid Grid.Row="2" Background="#A0A0A0">
            <!-- Project / Document Opened ဖြစ်လာမှ ဤနေရာတွင် Layout / Canvas တက်လာမည်ဖြစ်ပါသည် -->
        </Grid>

        <!-- 4. Status Bar -->
        <StatusBar Grid.Row="3" Background="#F0F0F0" BorderThickness="0,1,0,0" BorderBrush="#D0D0D0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" Foreground="#333333"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
