<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="700" Width="1000"
        Loaded="MainWindow_Loaded">

    <Window.Resources>
        <!-- Card Window အတွက် Context Menu အပြည့်အစုံ -->
        <ContextMenu x:Key="CardContextMenu">
            <MenuItem Header="Cut" IsEnabled="False"/>
            <MenuItem Header="Copy" IsEnabled="False"/>
            <MenuItem Header="Paste" IsEnabled="False"/>
            <Separator/>
            <MenuItem Header="Insert Text Field"/>
            <MenuItem Header="Insert Photo Field"/>
            <MenuItem Header="Insert Date Field"/>
            <MenuItem Header="Insert Signature Field"/>
            <MenuItem Header="Insert Bar Code Field"/>
            <MenuItem Header="Insert Magnetic Stripe Field"/>
            <MenuItem Header="Insert Smart Card Field"/>
            <MenuItem Header="Insert Variable Graphic Field"/>
            <Separator/>
            <MenuItem Header="Insert Static Text Field"/>
            <MenuItem Header="Insert Static Graphic Field"/>
            <MenuItem Header="Insert Non-Printable Area"/>
            <MenuItem Header="Insert Shape">
                <MenuItem Header="Line"/>
                <MenuItem Header="Rectangle"/>
                <MenuItem Header="Ellipse"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Select Fields">
                <MenuItem Header="None"/>
            </MenuItem>
            <MenuItem Header="Select All Fields" IsEnabled="False"/>
            <Separator/>
            <MenuItem Header="Field Names"/>
            <MenuItem Header="Sample Data" IsCheckable="True" IsChecked="True"/>
            <Separator/>
            <MenuItem Header="Portrait"/>
            <MenuItem Header="Landscape" IsCheckable="True" IsChecked="True"/>
            <Separator/>
            <MenuItem Header="Save Project"/>
            <MenuItem Header="Print Sample Card..."/>
            <Separator/>
            <MenuItem Header="Card Properties..."/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New Project..." Click="NewProject_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Edit"/>
            <MenuItem Header="View"/>
            <MenuItem Header="Format"/>
            <MenuItem Header="Tools"/>
            <MenuItem Header="Window"/>
            <MenuItem Header="Help"/>
        </Menu>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Grid -->
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Front Card Section -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="3">
                <TextBlock Text="Card" FontWeight="Bold" Foreground="#002D62" DockPanel.Dock="Top" Margin="2,0,0,2"/>
                <Border BorderBrush="#ABADB3" BorderThickness="1" Background="#F0F0F0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="FrontTopRulerScrollViewer" Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="FrontTopRulerCanvas" Height="30" SizeChanged="FrontTopRulerCanvas_SizeChanged"/>
                        </ScrollViewer>
                        
                        <ScrollViewer x:Name="FrontLeftRulerScrollViewer" Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <Canvas x:Name="FrontLeftRulerCanvas" Width="30" SizeChanged="FrontLeftRulerCanvas_SizeChanged"/>
                        </ScrollViewer>

                        <ScrollViewer x:Name="FrontMainScrollViewer" Grid.Row="1" Grid.Column="1" ScrollChanged="FrontMainScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <!-- Context Menu ထည့်သွင်းထားသော Front Document Border -->
                            <Border x:Name="FrontDocumentBorder" Width="340" Height="215" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="10" ContextMenu="{StaticResource CardContextMenu}">
                                <Canvas x:Name="FrontCardOverlayCanvas" Width="340" Height="215"
                                        MouseLeftButtonDown="FrontCardOverlayCanvas_MouseLeftButtonDown"
                                        MouseMove="FrontCardOverlayCanvas_MouseMove"
                                        MouseLeftButtonUp="FrontCardOverlayCanvas_MouseLeftButtonUp"/>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Production Form Section -->
            <DockPanel Grid.Row="0" Grid.Column="1" Margin="3">
                <TextBlock Text="Production Form" FontWeight="Bold" Foreground="#002D62" DockPanel.Dock="Top" Margin="2,0,0,2"/>
                <Border BorderBrush="#ABADB3" BorderThickness="1" Background="White">
                    <Grid/>
                </Border>
            </DockPanel>

            <!-- Back Card Section -->
            <DockPanel Grid.Row="1" Grid.Column="0" Margin="3">
                <TextBlock Text="Card (back side)" FontWeight="Bold" Foreground="#002D62" DockPanel.Dock="Top" Margin="2,0,0,2"/>
                <Border BorderBrush="#ABADB3" BorderThickness="1" Background="#F0F0F0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="BackTopRulerScrollViewer" Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="BackTopRulerCanvas" Height="30" SizeChanged="BackTopRulerCanvas_SizeChanged"/>
                        </ScrollViewer>
                        
                        <ScrollViewer x:Name="BackLeftRulerScrollViewer" Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <Canvas x:Name="BackLeftRulerCanvas" Width="30" SizeChanged="BackLeftRulerCanvas_SizeChanged"/>
                        </ScrollViewer>

                        <ScrollViewer x:Name="BackMainScrollViewer" Grid.Row="1" Grid.Column="1" ScrollChanged="BackMainScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <!-- Context Menu ထည့်သွင်းထားသော Back Document Border -->
                            <Border x:Name="BackDocumentBorder" Width="340" Height="215" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="10" ContextMenu="{StaticResource CardContextMenu}">
                                <Canvas x:Name="BackCardOverlayCanvas" Width="340" Height="215"
                                        MouseLeftButtonDown="BackCardOverlayCanvas_MouseLeftButtonDown"
                                        MouseMove="BackCardOverlayCanvas_MouseMove"
                                        MouseLeftButtonUp="BackCardOverlayCanvas_MouseLeftButtonUp"/>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Report Section -->
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="3">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="2,0,0,2">
                    <TextBlock Text="Report" FontWeight="Bold" Foreground="#002D62" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ReportSizeComboBox" Width="180" SelectionChanged="ReportSizeComboBox_SelectionChanged" DockPanel.Dock="Right">
                        <ComboBoxItem Tag="A4" IsSelected="True">A4 (21.0 x 29.7 cm)</ComboBoxItem>
                        <ComboBoxItem Tag="A5">A5</ComboBoxItem>
                        <ComboBoxItem Tag="B5">B5</ComboBoxItem>
                        <ComboBoxItem Tag="Letter">Letter</ComboBoxItem>
                        <ComboBoxItem Tag="Legal">Legal</ComboBoxItem>
                    </ComboBox>
                </DockPanel>
                
                <Border BorderBrush="#ABADB3" BorderThickness="1" Background="#F0F0F0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="ReportTopRulerScrollViewer" Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="ReportTopRulerCanvas" Height="30" SizeChanged="ReportTopRulerCanvas_SizeChanged"/>
                        </ScrollViewer>
                        
                        <ScrollViewer x:Name="ReportLeftRulerScrollViewer" Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <Canvas x:Name="ReportLeftRulerCanvas" Width="30" SizeChanged="ReportLeftRulerCanvas_SizeChanged"/>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ReportMainScrollViewer" Grid.Row="1" Grid.Column="1" ScrollChanged="ReportMainScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Border x:Name="ReportDocumentBorder" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="10">
                                <Canvas x:Name="ReportOverlayCanvas"
                                        MouseLeftButtonDown="ReportOverlayCanvas_MouseLeftButtonDown"
                                        MouseMove="ReportOverlayCanvas_MouseMove"
                                        MouseLeftButtonUp="ReportOverlayCanvas_MouseLeftButtonUp"/>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
