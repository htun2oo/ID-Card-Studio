<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDWorksEnterpriseDesigner"
        mc:Ignorable="d"
        Title="Datacard ID Works Enterprise Designer" Height="690" Width="1012"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenProjectCommand}" />
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.OnlineHelpCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="File">
                <MenuItem Header="New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" Command="{x:Static local:MainWindow.NewProjectCommand}" />
                <MenuItem Header="Open Project..." InputGestureText="Ctrl+O" Click="OpenProject_Click" Command="{x:Static local:MainWindow.OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="Recent File" IsEnabled="False" Foreground="Gray" />
                <Separator />
                <MenuItem x:Name="MenuCloseProject" Header="Close Project" Click="CloseProject_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep1" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProject" Header="Save Project" InputGestureText="Ctrl+S" Click="SaveProject_Click" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProjectAs" Header="Save Project As..." Click="SaveProjectAs_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep2" Visibility="Collapsed" />
                <MenuItem x:Name="MenuProjectProperties" Header="Project Properties..." InputGestureText="F7" Click="ProjectProperties_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep3" Visibility="Collapsed" />
                <MenuItem x:Name="MenuPrintCard" Header="Print Sample Card..." InputGestureText="Ctrl+P" Click="PrintSampleCard_Click" Visibility="Collapsed" />
                <MenuItem Header="Preview Sample Report..." IsEnabled="False" Foreground="Gray" Visibility="Collapsed" />
                <MenuItem Header="Report Page Setup..." IsEnabled="False" Foreground="Gray" Click="ReportPageSetup_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep4" Visibility="Collapsed" />
                <MenuItem x:Name="MenuDeleteProject" Header="Delete Project" Click="DeleteProject_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep5" Visibility="Collapsed" />
                <MenuItem x:Name="MenuRecentFileItem" Header="1 C:\Users\...\Sample\Sample.iwp" Click="RecentFile_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep6" Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>

            <MenuItem x:Name="MenuEdit" Header="Edit" Visibility="Collapsed">
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="False" />
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" IsEnabled="False" />
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Delete" InputGestureText="Del" IsEnabled="False" />
                <MenuItem Header="Select All" InputGestureText="Ctrl+A" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True" Style="{StaticResource CheckMenuItemStyle}" />
                    <Separator />
                    <MenuItem Header="Large Toolbar Buttons" Style="{StaticResource RadioMenuItemStyle}" IsChecked="True" Click="LargeToolbar_Click" x:Name="LargeToolbarMenu" />
                    <MenuItem Header="Small Toolbar Buttons" Style="{StaticResource RadioMenuItemStyle}" IsChecked="False" Click="SmallToolbar_Click" x:Name="SmallToolbarMenu" />
                </MenuItem>
            </MenuItem>

            <MenuItem x:Name="MenuInsert" Header="Insert" Visibility="Collapsed">
                <MenuItem Header="Text Field" />
            </MenuItem>
            <MenuItem x:Name="MenuFormat" Header="Format" Visibility="Collapsed">
                <MenuItem Header="Align" />
            </MenuItem>
            <MenuItem x:Name="MenuTools" Header="Tools" Visibility="Collapsed">
                <MenuItem Header="Options..." />
            </MenuItem>
            <MenuItem x:Name="MenuWindow" Header="Window" Visibility="Collapsed">
                <MenuItem Header="Cascade" />
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="Online Help..." InputGestureText="F1" Click="OnlineHelp_Click" />
                <Separator />
                <MenuItem Header="About..." Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ToolBar Tray -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0">
            <ToolBar Background="#F0F0F0" Band="1" BandIndex="1">
                <Button Content="🗂️" ToolTip="New Project" Click="NewProject_Click"/>
                <Button Content="📂" ToolTip="Open Project" Click="OpenProject_Click"/>
                <Button Content="💾" ToolTip="Save Project" Click="SaveProject_Click"/>
                <Button Content="🖨️" ToolTip="Print" Click="PrintSampleCard_Click"/>
                <Separator/>
                <Button Content="❓" ToolTip="Help" Click="OnlineHelp_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area -->
        <Grid x:Name="MdiHostGrid" Background="#808080">
            <Grid x:Name="ProjectWorkspace" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Card Windows (Front & Back) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Front Card Window -->
                    <Border Grid.Row="0" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Card" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                                    
                                    <!-- Front Top Ruler -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <Canvas x:Name="FrontTopRulerCanvas" Height="24" Background="Transparent" Margin="10,0,0,0" 
                                                    SizeChanged="FrontTopRulerCanvas_SizeChanged"
                                                    MouseLeftButtonDown="TopRuler_MouseLeftButtonDown"
                                                    Tag="{Binding ElementName=FrontCardOverlayCanvas}">
                                                <Grid Width="500">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="0" FontSize="9" FontWeight="Bold" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="1" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="2" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="3" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="4" Text="4" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="5" Text="5" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="6" Text="6" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="7" Text="7" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="8" Text="8" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="9" Text="9" FontSize="9" Margin="2,4,0,0"/>
                                                </Grid>
                                            </Canvas>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Front Left Ruler -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <Canvas x:Name="FrontLeftRulerCanvas" Width="24" Background="Transparent" Margin="0,10,0,0" 
                                                    SizeChanged="FrontLeftRulerCanvas_SizeChanged"
                                                    MouseLeftButtonDown="LeftRuler_MouseLeftButtonDown"
                                                    Tag="{Binding ElementName=FrontCardOverlayCanvas}">
                                                <Grid Height="300">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="0" FontSize="9" FontWeight="Bold" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="1" Text="1" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="2" Text="2" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="3" Text="3" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="4" Text="4" FontSize="9" Margin="4,2,0,0"/>
                                                </Grid>
                                            </Canvas>
                                        </ScrollViewer>
                                    </Border>

                                    <ScrollViewer x:Name="FrontMainScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6" ScrollChanged="FrontMainScrollViewer_ScrollChanged">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,20,20">
                                            <Border Width="323.57" Height="204.04" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                            <Canvas x:Name="FrontCardOverlayCanvas" Width="323.57" Height="204.04" Background="Transparent" IsHitTestVisible="True"
                                                MouseLeftButtonDown="GuidesCanvas_MouseLeftButtonDown"
                                                MouseMove="GuidesCanvas_MouseMove"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Back Card Window -->
                    <Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Card (back side)" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                                    
                                    <!-- Back Top Ruler -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <Canvas x:Name="BackTopRulerCanvas" Height="24" Background="Transparent" Margin="10,0,0,0" 
                                                    SizeChanged="BackTopRulerCanvas_SizeChanged"
                                                    MouseLeftButtonDown="TopRuler_MouseLeftButtonDown"
                                                    Tag="{Binding ElementName=BackCardOverlayCanvas}">
                                                <Grid Width="500">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="0" FontSize="9" FontWeight="Bold" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="1" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="2" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="3" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="4" Text="4" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="5" Text="5" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="6" Text="6" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="7" Text="7" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="8" Text="8" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="9" Text="9" FontSize="9" Margin="2,4,0,0"/>
                                                </Grid>
                                            </Canvas>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Back Left Ruler -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <Canvas x:Name="BackLeftRulerCanvas" Width="24" Background="Transparent" Margin="0,10,0,0" 
                                                    SizeChanged="BackLeftRulerCanvas_SizeChanged"
                                                    MouseLeftButtonDown="LeftRuler_MouseLeftButtonDown"
                                                    Tag="{Binding ElementName=BackCardOverlayCanvas}">
                                                <Grid Height="300">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="0" FontSize="9" FontWeight="Bold" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="1" Text="1" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="2" Text="2" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="3" Text="3" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="4" Text="4" FontSize="9" Margin="4,2,0,0"/>
                                                </Grid>
                                            </Canvas>
                                        </ScrollViewer>
                                    </Border>

                                    <ScrollViewer x:Name="BackMainScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6" ScrollChanged="BackMainScrollViewer_ScrollChanged">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,20,20">
                                            <Border Width="323.57" Height="204.04" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                            <Canvas x:Name="BackCardOverlayCanvas" Width="323.57" Height="204.04" Background="Transparent" IsHitTestVisible="True"
                                                MouseLeftButtonDown="GuidesCanvas_MouseLeftButtonDown"
                                                MouseMove="GuidesCanvas_MouseMove"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Production Form and Report Windows -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Production Form" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="White" Margin="4"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Report" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                                <ComboBox x:Name="ReportSizeComboBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0" Height="20" SelectionChanged="ReportSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="A4 (21.0 x 29.7 cm)" IsSelected="True"/>
                                </ComboBox>
                            </Grid>

                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                                    <!-- Report Top Ruler -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <Canvas x:Name="ReportTopRulerCanvas" Height="24" Background="Transparent" Margin="10,0,0,0" 
                                                    SizeChanged="ReportTopRulerCanvas_SizeChanged"
                                                    MouseLeftButtonDown="TopRuler_MouseLeftButtonDown"
                                                    Tag="{Binding ElementName=ReportOverlayCanvas}">
                                                <Grid Width="800">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                        <ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/><ColumnDefinition Width="37.8"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="0" FontSize="9" FontWeight="Bold" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="1" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="2" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="3" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="4" Text="4" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="5" Text="5" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="6" Text="6" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="7" Text="7" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="8" Text="8" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="9" Text="9" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="10" Text="10" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="11" Text="11" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="12" Text="12" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="13" Text="13" FontSize="9" Margin="2,4,0,0"/>
                                                    <TextBlock Grid.Column="14" Text="14" FontSize="9" Margin="2,4,0,0"/>
                                                </Grid>
                                            </Canvas>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Report Left Ruler -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <Canvas x:Name="ReportLeftRulerCanvas" Width="24" Background="Transparent" Margin="0,10,0,0" 
                                                    SizeChanged="ReportLeftRulerCanvas_SizeChanged"
                                                    MouseLeftButtonDown="LeftRuler_MouseLeftButtonDown"
                                                    Tag="{Binding ElementName=ReportOverlayCanvas}">
                                                <Grid Height="500">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/><RowDefinition Height="37.8"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="0" FontSize="9" FontWeight="Bold" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="1" Text="1" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="2" Text="2" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="3" Text="3" FontSize="9" Margin="4,2,0,0"/>
                                                    <TextBlock Grid.Row="4" Text="4" FontSize="9" Margin="4,2,0,0"/>
                                                </Grid>
                                            </Canvas>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Report Workspace & Overlay Canvas -->
                                    <ScrollViewer x:Name="ReportMainScrollViewer" Grid.Row="1" Grid.Column="1" 
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                                  Background="#D6D6D6" ScrollChanged="ReportMainScrollViewer_ScrollChanged">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,20,20">
                                            <Border Width="793.8" Height="1122.6" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                            <Canvas x:Name="ReportOverlayCanvas" Width="793.8" Height="1122.6" Background="Transparent" IsHitTestVisible="True"
                                                MouseLeftButtonDown="GuidesCanvas_MouseLeftButtonDown"
                                                MouseMove="GuidesCanvas_MouseMove"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
