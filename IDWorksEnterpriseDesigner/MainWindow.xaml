<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="#808080">
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Insert"/>
            <MenuItem Header="F_ormat"/>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Window"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="22" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main MDI Workspace Area -->
        <Grid x:Name="MdiCanvas" Background="#808080" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <!-- Left Panel: Card & Card (back side) -->
            <StackPanel Grid.Column="0" Grid.RowSpan="2" x:Name="PnlCardContainer" Visibility="Collapsed" Margin="0,0,4,0">
                <!-- Card Front -->
                <Border x:Name="WinCardFront" Height="250" Background="#F0F0F0" BorderBrush="#7F9DB9" BorderThickness="2" Margin="0,0,0,6">
                    <DockPanel>
                        <!-- Window Title Bar -->
                        <Grid DockPanel.Dock="Top" Background="#B5C7DE" Height="20">
                            <TextBlock Text=" Card" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button Content="─" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                                <Button Content="□" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                                <Button Content="✕" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- Canvas Area with Rulers -->
                        <Grid Background="#FFFFFF" Margin="4">
                            <Border BorderBrush="#A0A0A0" BorderThickness="1">
                                <TextBlock Text="[ Card Design Area ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="11"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Card Back -->
                <Border x:Name="WinCardBack" Height="250" Background="#F0F0F0" BorderBrush="#7F9DB9" BorderThickness="2">
                    <DockPanel>
                        <!-- Window Title Bar -->
                        <Grid DockPanel.Dock="Top" Background="#B5C7DE" Height="20">
                            <TextBlock Text=" Card (back side)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button Content="─" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                                <Button Content="□" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                                <Button Content="✕" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- Canvas Area with Rulers -->
                        <Grid Background="#FFFFFF" Margin="4">
                            <Border BorderBrush="#A0A0A0" BorderThickness="1">
                                <TextBlock Text="[ Card (back side) Area ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="11"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Top Right: Production Form -->
            <Border Grid.Column="1" Grid.Row="0" x:Name="WinProductionForm" Visibility="Collapsed" Background="#F0F0F0" BorderBrush="#7F9DB9" BorderThickness="2" Margin="0,0,0,4">
                <DockPanel>
                    <!-- Window Title Bar -->
                    <Grid DockPanel.Dock="Top" Background="#B5C7DE" Height="20">
                        <TextBlock Text=" Production Form" FontSize="11" FontWeight="Bold" Foreground="#000080" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Button Content="─" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                            <Button Content="□" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                            <Button Content="✕" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- Production Form Workspace -->
                    <Grid Background="#FFFFFF" Margin="4">
                        <Border BorderBrush="#A0A0A0" BorderThickness="1">
                            <TextBlock Text="[ Production Form Workspace ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="12"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Bottom Right: Report Design -->
            <Border Grid.Column="1" Grid.Row="1" x:Name="WinReport" Visibility="Collapsed" Background="#F0F0F0" BorderBrush="#7F9DB9" BorderThickness="2">
                <DockPanel>
                    <!-- Window Title Bar -->
                    <Grid DockPanel.Dock="Top" Background="#B5C7DE" Height="20">
                        <TextBlock Text=" Report" FontSize="11" FontWeight="Bold" Foreground="#008000" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Button Content="─" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                            <Button Content="□" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                            <Button Content="✕" Width="16" Height="14" FontSize="8" Margin="1,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- Report Workspace -->
                    <Grid Background="#FFFFFF" Margin="4">
                        <Border BorderBrush="#A0A0A0" BorderThickness="1">
                            <TextBlock Text="[ Report Workspace ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="11"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
