<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Datacard ID Works Enterprise Designer" Height="690" Width="1012"
        WindowStartupLocation="CenterScreen">
<!-- Top Menu Bar (ပရောဂျက်ဖွင့်ပြီးနောက် မီနူးအပြည့်အစုံပေါ်စေရန်) -->
<Menu DockPanel.Dock="Top" Background="#F0F0F0">
    <MenuItem Header="File">
        <MenuItem Header="New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
        <MenuItem Header="Open Project..." InputGestureText="Ctrl+O" />
        <MenuItem Header="Close Project" />
        <Separator />
        <MenuItem Header="Save Project" InputGestureText="Ctrl+S" />
        <MenuItem Header="Save Project As..." />
        <Separator />
        <MenuItem Header="Project Properties..." InputGestureText="F7" />
        <Separator />
        <MenuItem Header="Print Sample Card..." InputGestureText="Ctrl+P" />
        <MenuItem Header="Preview Sample Report..." IsEnabled="False" Foreground="Gray" />
        <MenuItem Header="Report Page Setup..." IsEnabled="False" Foreground="Gray" Click="ReportPageSetup_Click" />
        <Separator />
        <MenuItem Header="Delete Project" />
        <Separator />
        <MenuItem Header="1 C:\Users\...\Sample\Sample.iwp" />
        <Separator />
        <MenuItem Header="Exit" Click="Exit_Click" />
    </MenuItem>
    <MenuItem Header="Edit">
        <MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="False" />
        <MenuItem Header="Copy" InputGestureText="Ctrl+C" IsEnabled="False" />
        <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" />
        <Separator />
        <MenuItem Header="Delete" InputGestureText="Del" IsEnabled="False" />
        <MenuItem Header="Select All" InputGestureText="Ctrl+A" IsEnabled="False" />
    </MenuItem>
    <MenuItem Header="View">
        <MenuItem Header="Toolbars" />
    </MenuItem>
    <MenuItem Header="Insert">
        <MenuItem Header="Text Field" />
        <MenuItem Header="Photo Field" />
    </MenuItem>
    <MenuItem Header="Format">
        <MenuItem Header="Align" />
    </MenuItem>
    <MenuItem Header="Tools">
        <MenuItem Header="Options..." />
    </MenuItem>
    <MenuItem Header="Window">
        <MenuItem Header="Cascade" />
        <MenuItem Header="Tile" />
    </MenuItem>
    <MenuItem Header="Help">
        <MenuItem Header="Online Help..." InputGestureText="F1" />
    </MenuItem>
</Menu>
