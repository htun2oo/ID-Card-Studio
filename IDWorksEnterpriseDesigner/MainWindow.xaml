<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Datacard ID Works Enterprise Designer" Height="690" Width="1012"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <!-- 1. File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" />
                <Separator x:Name="Sep1" Visibility="Collapsed" />
                <MenuItem x:Name="MenuCloseProject" Header="_Close Project" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProject" Header="_Save Project" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProjectAs" Header="Save Project _As..." Visibility="Collapsed" />
                <MenuItem x:Name="MenuProjectProperties" Header="Project _Properties..." Visibility="Collapsed" />
                <Separator x:Name="Sep3" Visibility="Collapsed" />
                <MenuItem x:Name="MenuPrintSampleCard" Header="_Print Sample Card..." Visibility="Collapsed" />
                <MenuItem x:Name="MenuPreviewSampleReport" Header="Pre_view Sample Report..." Visibility="Collapsed" />
                <MenuItem Header="Report Page Set_up..." Click="ReportPageSetup_Click" />
                <Separator x:Name="Sep4" Visibility="Collapsed" />
                <MenuItem x:Name="MenuDeleteProject" Header="_Delete Project..." Visibility="Collapsed" />
                <Separator />
                <MenuItem x:Name="MenuRecentFile" Header="Recent File" IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>

            <!-- 2. Edit Menu -->
            <MenuItem x:Name="MenuEdit" Header="_Edit" Visibility="Collapsed">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" IsEnabled="False" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Cu_t Fields" InputGestureText="Ctrl+X" IsEnabled="False" />
                <MenuItem Header="_Copy Fields" InputGestureText="Ctrl+C" IsEnabled="False" />
                <MenuItem Header="_Paste Fields" InputGestureText="Ctrl+V" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Select _Fields..." />
                <MenuItem Header="Select _All Fields" InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="Field _Properties..." InputGestureText="Ctrl+F" IsEnabled="False" />
                <MenuItem Header="_Multi-field Text Properties..." />
                <MenuItem Header="M_ulti-field Prompt Properties..." />
                <MenuItem Header="P_roduction Form Properties..." InputGestureText="F6" />
                <Separator />
                <MenuItem Header="Field Tab Order" InputGestureText="Ctrl+B" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Delete Selected Fields" InputGestureText="Del" IsEnabled="False" />
                <MenuItem Header="Delete Production Form" />
            </MenuItem>

            <!-- 3. View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True" />
                    <Separator />
                    <MenuItem Header="Large Toolbar Buttons" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Small Toolbar Buttons" IsCheckable="True" IsChecked="False" />
                </MenuItem>
            </MenuItem>

            <!-- 4. Format Menu -->
            <MenuItem x:Name="MenuFormat" Header="F_ormat" Visibility="Collapsed" />

            <!-- 5. Tools Menu -->
            <MenuItem x:Name="MenuTools" Header="_Tools" Visibility="Collapsed" />

            <!-- 6. Window Menu -->
            <MenuItem x:Name="MenuWindow" Header="_Window" Visibility="Collapsed" />

            <!-- 7. Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_Online Help..." InputGestureText="F1" />
                <Separator />
                <MenuItem Header="_About..." />
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area -->
        <Grid x:Name="MdiHostGrid" Background="#808080">
            <Grid x:Name="ProjectWorkspace" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Card Windows -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Window (Front) -->
                    <Border Grid.Row="0" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Card" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                                        <Canvas ClipToBounds="True">
                                            <TextBlock Text="0" Canvas.Left="20" Canvas.Top="2" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="17.8" Y1="18" X2="17.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                                        <Canvas ClipToBounds="True">
                                            <TextBlock Text="0" Canvas.Left="4" Canvas.Top="15" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="18" Y1="13" X2="24" Y2="13" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17.8,13,0,0">
                                            <Border Width="323.57" Height="204.04" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Card Window (Back) -->
                    <Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Card (back side)" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                                        <Canvas ClipToBounds="True">
                                            <TextBlock Text="0" Canvas.Left="20" Canvas.Top="2" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="17.8" Y1="18" X2="17.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                                        <Canvas ClipToBounds="True">
                                            <TextBlock Text="0" Canvas.Left="4" Canvas.Top="15" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="18" Y1="13" X2="24" Y2="13" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17.8,13,0,0">
                                            <Border Width="323.57" Height="204.04" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Production Form and Report Windows -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Production Form Window -->
                    <Border Grid.Row="0" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Production Form" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="White" Margin="4"/>
                        </DockPanel>
                    </Border>

                    <!-- Report Window -->
                    <Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <!-- Report Header with Paper Size Selector ComboBox -->
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Report" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                                <ComboBox x:Name="ReportSizeComboBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0" Height="20" SelectionChanged="ReportSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="A4 (8.3 x 11.7 in)" Tag="A4" IsSelected="True"/>
                                    <ComboBoxItem Content="A5 (5.8 x 8.3 in)" Tag="A5"/>
                                    <ComboBoxItem Content="B5 (6.9 x 9.8 in)" Tag="B5"/>
                                    <ComboBoxItem Content="Letter (8.5 x 11 in)" Tag="Letter"/>
                                    <ComboBoxItem Content="Legal (8.5 x 14 in)" Tag="Legal"/>
                                </ComboBox>
                            </Grid>

                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                                    <!-- Top Horizontal Ruler for Report -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                                        <Canvas ClipToBounds="True">
                                            <TextBlock Text="0" Canvas.Left="20" Canvas.Top="2" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="17.8" Y1="18" X2="17.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Left Vertical Ruler for Report -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                                        <Canvas ClipToBounds="True">
                                            <TextBlock Text="0" Canvas.Left="4" Canvas.Top="15" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="18" Y1="13" X2="24" Y2="13" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Report Document Canvas/Border with Dynamic Size -->
                                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17.8,13,0,0">
                                            <Border x:Name="ReportDocumentBorder" Width="450" Height="635" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
