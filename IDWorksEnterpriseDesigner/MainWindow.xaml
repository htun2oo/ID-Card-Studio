<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="690" Width="1012"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <!-- 1. File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" />
                <Separator x:Name="Sep1" Visibility="Collapsed" />
                <MenuItem x:Name="MenuCloseProject" Header="_Close Project" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProject" Header="_Save Project" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProjectAs" Header="Save Project _As..." Visibility="Collapsed" />
                <Separator x:Name="Sep2" Visibility="Collapsed" />
                <MenuItem x:Name="MenuProjectProperties" Header="Project _Properties..." Visibility="Collapsed" />
                <Separator x:Name="Sep3" Visibility="Collapsed" />
                <MenuItem x:Name="MenuPrintSampleCard" Header="_Print Sample Card..." Visibility="Collapsed" />
                <MenuItem x:Name="MenuPreviewSampleReport" Header="Pre_view Sample Report..." Visibility="Collapsed" />
                <MenuItem x:Name="MenuReportPageSetup" Header="Report Page Set_up..." Visibility="Collapsed" />
                <Separator x:Name="Sep4" Visibility="Collapsed" />
                <MenuItem x:Name="MenuDeleteProject" Header="_Delete Project..." Visibility="Collapsed" />
                <Separator />
                <MenuItem x:Name="MenuRecentFile" Header="Recent File" IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>

            <!-- 2. Edit Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuEdit" Header="_Edit" Visibility="Collapsed" />

            <!-- 3. View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True" />
                    <Separator />
                    <MenuItem Header="Large Toolbar Buttons" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Small Toolbar Buttons" IsCheckable="True" IsChecked="False" />
                </MenuItem>
                <MenuItem Header="Show Welcome on startup" IsCheckable="True" IsChecked="True" />
            </MenuItem>

            <!-- 4. Insert Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuInsert" Header="_Insert" Visibility="Collapsed" />

            <!-- 5. Format Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuFormat" Header="F_ormat" Visibility="Collapsed" />

            <!-- 6. Tools Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuTools" Header="_Tools" Visibility="Collapsed" />

            <!-- 7. Window Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="MenuWindow" Header="_Window" Visibility="Collapsed" />

            <!-- 8. Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_Online Help..." InputGestureText="F1" />
                <Separator />
                <MenuItem Header="_About..." />
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area -->
        <Grid x:Name="MdiHostGrid" Background="Gray">
            <!-- 2x2 Layout Grid for Sub Windows -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Window 1: Card View -->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#707070" BorderThickness="1" Margin="2" Background="#D4D0C8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="20">
                        <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10,10,10,25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top Ruler -->
                            <Canvas Grid.Row="0" Grid.Column="1" Height="20" Width="300" Background="#F0F0F0" ClipToBounds="False">
                                <TextBlock Text="1" Canvas.Left="35" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="2" Canvas.Left="75" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="3" Canvas.Left="115" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="4" Canvas.Left="155" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="5" Canvas.Left="195" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="6" Canvas.Left="235" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="7" Canvas.Left="275" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="8" Canvas.Left="295" Canvas.Top="2" FontSize="9"/>
                            </Canvas>

                            <!-- Left Ruler (Ruler အပြည့်ပေါ်စေရန် Height နှင့် Layout ကို ချိန်ထားပါသည်) -->
                            <Canvas Grid.Row="1" Grid.Column="0" Width="20" Height="200" Background="#F0F0F0" ClipToBounds="False">
                                <TextBlock Text="1" Canvas.Left="5" Canvas.Top="30" FontSize="9"/>
                                <TextBlock Text="2" Canvas.Left="5" Canvas.Top="70" FontSize="9"/>
                                <TextBlock Text="3" Canvas.Left="5" Canvas.Top="110" FontSize="9"/>
                                <TextBlock Text="4" Canvas.Left="5" Canvas.Top="150" FontSize="9"/>
                                <TextBlock Text="5" Canvas.Left="5" Canvas.Top="180" FontSize="9"/>
                            </Canvas>

                            <!-- Card Surface -->
                            <Border Grid.Row="1" Grid.Column="1" Width="300" Height="180" Background="White" BorderBrush="Black" BorderThickness="1" VerticalAlignment="Top">
                                <Canvas x:Name="CardFrontCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Window 2: Production Form -->
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="#707070" BorderThickness="1" Margin="2" Background="White">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="20">
                        <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                    <Grid Background="White"/>
                </DockPanel>
            </Border>

            <!-- Window 3: Card (back side) View -->
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#707070" BorderThickness="1" Margin="2" Background="#D4D0C8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="20">
                        <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10,10,10,25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top Ruler -->
                            <Canvas Grid.Row="0" Grid.Column="1" Height="20" Width="300" Background="#F0F0F0" ClipToBounds="False">
                                <TextBlock Text="1" Canvas.Left="35" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="2" Canvas.Left="75" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="3" Canvas.Left="115" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="4" Canvas.Left="155" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="5" Canvas.Left="195" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="6" Canvas.Left="235" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="7" Canvas.Left="275" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="8" Canvas.Left="295" Canvas.Top="2" FontSize="9"/>
                            </Canvas>

                            <!-- Left Ruler (Ruler အပြည့်ပေါ်စေရန် Height နှင့် Layout ကို ချိန်ထားပါသည်) -->
                            <Canvas Grid.Row="1" Grid.Column="0" Width="20" Height="200" Background="#F0F0F0" ClipToBounds="False">
                                <TextBlock Text="1" Canvas.Left="5" Canvas.Top="30" FontSize="9"/>
                                <TextBlock Text="2" Canvas.Left="5" Canvas.Top="70" FontSize="9"/>
                                <TextBlock Text="3" Canvas.Left="5" Canvas.Top="110" FontSize="9"/>
                                <TextBlock Text="4" Canvas.Left="5" Canvas.Top="150" FontSize="9"/>
                                <TextBlock Text="5" Canvas.Left="5" Canvas.Top="180" FontSize="9"/>
                            </Canvas>

                            <!-- Card Surface -->
                            <Border Grid.Row="1" Grid.Column="1" Width="300" Height="180" Background="White" BorderBrush="Black" BorderThickness="1" VerticalAlignment="Top">
                                <Canvas x:Name="CardBackCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Window 4: Report View -->
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#707070" BorderThickness="1" Margin="2" Background="#D4D0C8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0A246A" Height="20">
                        <TextBlock Text="Report" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10,10,10,25" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Report Top Ruler -->
                            <Canvas Grid.Row="0" Grid.Column="1" Height="20" Width="850" Background="#F0F0F0" ClipToBounds="False">
                                <TextBlock Text="1" Canvas.Left="35" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="2" Canvas.Left="75" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="3" Canvas.Left="115" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="4" Canvas.Left="155" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="5" Canvas.Left="195" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="6" Canvas.Left="235" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="7" Canvas.Left="275" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="8" Canvas.Left="315" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="9" Canvas.Left="355" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="10" Canvas.Left="395" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="11" Canvas.Left="435" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="12" Canvas.Left="475" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="13" Canvas.Left="515" Canvas.Top="2" FontSize="9"/>
                                <TextBlock Text="14" Canvas.Left="555" Canvas.Top="2" FontSize="9"/>
                            </Canvas>

                            <!-- Report Left Ruler -->
                            <Canvas Grid.Row="1" Grid.Column="0" Width="20" Height="1000" Background="#F0F0F0" ClipToBounds="False">
                                <TextBlock Text="1" Canvas.Left="5" Canvas.Top="30" FontSize="9"/>
                                <TextBlock Text="2" Canvas.Left="5" Canvas.Top="70" FontSize="9"/>
                                <TextBlock Text="3" Canvas.Left="5" Canvas.Top="110" FontSize="9"/>
                                <TextBlock Text="4" Canvas.Left="5" Canvas.Top="150" FontSize="9"/>
                                <TextBlock Text="5" Canvas.Left="5" Canvas.Top="190" FontSize="9"/>
                                <TextBlock Text="6" Canvas.Left="5" Canvas.Top="230" FontSize="9"/>
                            </Canvas>

                            <!-- Full Report Paper Surface -->
                            <Border Grid.Row="1" Grid.Column="1" Width="850" Height="1000" Background="White" BorderBrush="Black" BorderThickness="1">
                                <Canvas x:Name="ReportCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
