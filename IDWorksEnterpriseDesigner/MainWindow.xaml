<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Datacard ID Works Enterprise Designer" Height="690" Width="1012"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- MenuItem အမှန်ခြစ်ဘေးမှ အပြာရောင် Background Highlight Box ကို ဖျောက်ရန် Style -->
        <Style TargetType="MenuItem">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="Transparent"/>
            </Style.Resources>
        </Style>

        <!-- Radio / Dot Style (Large/Small Buttons အတွက် အစက်ပြရန်) -->
        <Style x:Key="RadioMenuItemStyle" TargetType="MenuItem">
            <Setter Property="IsCheckable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" Height="22" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" MinWidth="24" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="17"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- အစက် (Dot) ပုံစံလေးကို IsChecked ဖြစ်မှ ပြသမည် -->
                                <Ellipse x:Name="BulletMark" Grid.Column="0" Width="5" Height="5" Fill="Black" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Header}" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BulletMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Keyboard Shortcuts (Ctrl+N နှင့် Ctrl+O အလုပ်လုပ်စေရန်) -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="File">
                <MenuItem Header="New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="Open Project..." InputGestureText="Ctrl+O" Click="OpenProject_Click" />
                
                <MenuItem x:Name="MenuCloseProject" Header="Close Project" Click="CloseProject_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep1" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProject" Header="Save Project" InputGestureText="Ctrl+S" Click="SaveProject_Click" Visibility="Collapsed" />
                <MenuItem x:Name="MenuSaveProjectAs" Header="Save Project As..." Click="SaveProjectAs_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep2" Visibility="Collapsed" />
                <MenuItem x:Name="MenuProjectProperties" Header="Project Properties..." InputGestureText="F7" Click="ProjectProperties_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep3" Visibility="Collapsed" />
                <MenuItem x:Name="MenuPrintCard" Header="Print Sample Card..." InputGestureText="Ctrl+P" Click="PrintSampleCard_Click" Visibility="Collapsed" />
                <MenuItem Header="Preview Sample Report..." IsEnabled="False" Foreground="Gray" Visibility="Collapsed" />
                <MenuItem Header="Report Page Setup..." IsEnabled="False" Foreground="Gray" Click="ReportPageSetup_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep4" Visibility="Collapsed" />
                <MenuItem x:Name="MenuDeleteProject" Header="Delete Project" Click="DeleteProject_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep5" Visibility="Collapsed" />
                <MenuItem x:Name="MenuRecentFileItem" Header="1 C:\Users\...\Sample\Sample.iwp" Click="RecentFile_Click" Visibility="Collapsed" />
                <Separator x:Name="MenuSep6" Visibility="Collapsed" />

                <Separator />
                <MenuItem Header="Recent File" IsEnabled="False" Foreground="Gray" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>

            <MenuItem x:Name="MenuEdit" Header="Edit" Visibility="Collapsed">
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="False" />
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" IsEnabled="False" />
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Delete" InputGestureText="Del" IsEnabled="False" />
                <MenuItem Header="Select All" InputGestureText="Ctrl+A" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True" />
                    <Separator />
                    <MenuItem Header="Large Toolbar Buttons" Style="{StaticResource RadioMenuItemStyle}" IsChecked="True" Click="LargeToolbar_Click" x:Name="LargeToolbarMenu" />
                    <MenuItem Header="Small Toolbar Buttons" Style="{StaticResource RadioMenuItemStyle}" IsChecked="False" Click="SmallToolbar_Click" x:Name="SmallToolbarMenu" />
                </MenuItem>
                <!-- Toolbars နှင့် Show Welcome on startup ကြားတွင် Separator ထည့်သွင်းထားသည် -->
                <Separator />
                <MenuItem Header="Show Welcome on startup" IsCheckable="True" IsChecked="True" />
            </MenuItem>

            <MenuItem x:Name="MenuInsert" Header="Insert" Visibility="Collapsed">
                <MenuItem Header="Text Field" />
                <MenuItem Header="Photo Field" />
            </MenuItem>
            <MenuItem x:Name="MenuFormat" Header="Format" Visibility="Collapsed">
                <MenuItem Header="Align" />
            </MenuItem>
            <MenuItem x:Name="MenuTools" Header="Tools" Visibility="Collapsed">
                <MenuItem Header="Options..." />
            </MenuItem>
            <MenuItem x:Name="MenuWindow" Header="Window" Visibility="Collapsed">
                <MenuItem Header="Cascade" />
                <MenuItem Header="Tile" />
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="Online Help..." InputGestureText="F1" Click="OnlineHelp_Click" />
                <Separator />
                <MenuItem Header="About..." Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ToolBar Tray -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0">
            <ToolBar Background="#F0F0F0" Band="1" BandIndex="1">
                <Button Content="🗂️" ToolTip="New Project" Click="NewProject_Click"/>
                <Button Content="📂" ToolTip="Open Project" Click="OpenProject_Click"/>
                <Button Content="💾" ToolTip="Save Project" Click="SaveProject_Click"/>
                <Button Content="🖨️" ToolTip="Print" Click="PrintSampleCard_Click"/>
                <Separator/>
                <Button Content="❓" ToolTip="Help"/>
                <Separator/>
                <Button Content="✂️" ToolTip="Cut" IsEnabled="False"/>
                <Button Content="📋" ToolTip="Copy" IsEnabled="False"/>
                <Button Content="📄" ToolTip="Paste" IsEnabled="False"/>
                <Separator/>
                <Button Content="↩️" ToolTip="Undo"/>
                <Button Content="↪️" ToolTip="Redo"/>
                <Separator/>
                <Button Content="🔍" ToolTip="Zoom In"/>
                <Button Content="🔎" ToolTip="Zoom Out"/>
                <Separator/>
                <Button Content="📐" ToolTip="Rulers"/>
                <Button Content="📏" ToolTip="Grid Lines"/>
                <Separator/>
                <ComboBox Width="70" Height="22" SelectedIndex="0">
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="25%"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area -->
        <Grid x:Name="MdiHostGrid" Background="#808080">
            <Grid x:Name="ProjectWorkspace" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Card Windows (Front & Back) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Front Card Window -->
                    <Border Grid.Row="0" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Card" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                                    
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1" ClipToBounds="True">
                                        <ScrollViewer x:Name="FrontTopRulerScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <Canvas x:Name="FrontTopRulerCanvas" Height="24" Background="Transparent" Margin="10,0,0,0" SizeChanged="FrontTopRulerCanvas_SizeChanged"/>
                                        </ScrollViewer>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" ClipToBounds="True">
                                        <ScrollViewer x:Name="FrontLeftRulerScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <Canvas x:Name="FrontLeftRulerCanvas" Width="24" Background="Transparent" Margin="0,10,0,0" SizeChanged="FrontLeftRulerCanvas_SizeChanged"/>
                                        </ScrollViewer>
                                    </Border>

                                    <ScrollViewer x:Name="FrontMainScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6" ScrollChanged="FrontMainScrollViewer_ScrollChanged">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,20,20">
                                            <Border Width="323.57" Height="204.04" Background="White" BorderBrush="#000000" BorderThickness="1">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Cut" IsEnabled="False"/>
                                                        <MenuItem Header="Copy" IsEnabled="False"/>
                                                        <MenuItem Header="Paste" IsEnabled="False"/>
                                                        <Separator/>
                                                        <MenuItem Header="Card Properties..."/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>
                                            <Canvas x:Name="FrontCardOverlayCanvas" Width="323.57" Height="204.04" Background="Transparent"
                                                    MouseLeftButtonDown="FrontCardOverlayCanvas_MouseLeftButtonDown"
                                                    MouseMove="FrontCardOverlayCanvas_MouseMove"
                                                    MouseLeftButtonUp="FrontCardOverlayCanvas_MouseLeftButtonUp"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Back Card Window -->
                    <Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Card (back side)" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>
                                    
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1" ClipToBounds="True">
                                        <ScrollViewer x:Name="BackTopRulerScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <Canvas x:Name="BackTopRulerCanvas" Height="24" Background="Transparent" Margin="10,0,0,0" SizeChanged="BackTopRulerCanvas_SizeChanged"/>
                                        </ScrollViewer>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" ClipToBounds="True">
                                        <ScrollViewer x:Name="BackLeftRulerScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <Canvas x:Name="BackLeftRulerCanvas" Width="24" Background="Transparent" Margin="0,10,0,0" SizeChanged="BackLeftRulerCanvas_SizeChanged"/>
                                        </ScrollViewer>
                                    </Border>

                                    <ScrollViewer x:Name="BackMainScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6" ScrollChanged="BackMainScrollViewer_ScrollChanged">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,20,20">
                                            <Border Width="323.57" Height="204.04" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                            <Canvas x:Name="BackCardOverlayCanvas" Width="323.57" Height="204.04" Background="Transparent"
                                                    MouseLeftButtonDown="BackCardOverlayCanvas_MouseLeftButtonDown"
                                                    MouseMove="BackCardOverlayCanvas_MouseMove"
                                                    MouseLeftButtonUp="BackCardOverlayCanvas_MouseLeftButtonUp"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Production Form and Report Windows -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="22">
                                <TextBlock Text="Production Form" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                            </Grid>
                            <Border Background="White" Margin="4"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="2" BorderBrush="#708090" BorderThickness="1" Background="#CCCCCC">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="#D1D9E0" Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Report" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#000080"/>
                                <ComboBox x:Name="ReportSizeComboBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0" Height="20" SelectionChanged="ReportSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="A4 (21.0 x 29.7 cm)" Tag="A4" IsSelected="True"/>
                                    <ComboBoxItem Content="A5 (14.8 x 21.0 cm)" Tag="A5"/>
                                    <ComboBoxItem Content="B5 (17.6 x 25.0 cm)" Tag="B5"/>
                                    <ComboBoxItem Content="Letter (8.5 x 11 in)" Tag="Letter"/>
                                    <ComboBoxItem Content="Legal (8.5 x 14 in)" Tag="Legal"/>
                                </ComboBox>
                            </Grid>

                            <Border Background="#CCCCCC" Padding="4">
                                <Grid Background="#E6E6E6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1" ClipToBounds="True">
                                        <ScrollViewer x:Name="ReportTopRulerScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <Canvas x:Name="ReportTopRulerCanvas" Height="24" Background="Transparent" Margin="10,0,0,0" SizeChanged="ReportTopRulerCanvas_SizeChanged"/>
                                        </ScrollViewer>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0" ClipToBounds="True">
                                        <ScrollViewer x:Name="ReportLeftRulerScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <Canvas x:Name="ReportLeftRulerCanvas" Width="24" Background="Transparent" Margin="0,10,0,0" SizeChanged="ReportLeftRulerCanvas_SizeChanged"/>
                                        </ScrollViewer>
                                    </Border>

                                    <ScrollViewer x:Name="ReportMainScrollViewer" Grid.Row="1" Grid.Column="1" 
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                                  Background="#D6D6D6" ScrollChanged="ReportMainScrollViewer_ScrollChanged">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,20,20">
                                            <Border x:Name="ReportDocumentBorder" Width="793.8" Height="1122.6" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                                            <Canvas x:Name="ReportOverlayCanvas" Width="793.8" Height="1122.6" Background="Transparent"
                                                    MouseLeftButtonDown="ReportOverlayCanvas_MouseLeftButtonDown"
                                                    MouseMove="ReportOverlayCanvas_MouseMove"
                                                    MouseLeftButtonUp="ReportOverlayCanvas_MouseLeftButtonUp"
                                                    IsHitTestVisible="True"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
