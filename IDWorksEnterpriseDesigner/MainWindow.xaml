                                            <Line X1="295.5" Y1="19" X2="295.5" Y2="24" Stroke="Black" StrokeThickness="0.75"/>
                                            <TextBlock Text="8" Canvas.Left="316.6" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                                            <Line X1="314.4" Y1="18" X2="314.4" Y2="24" Stroke="Black" StrokeThickness="1"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Left Vertical Ruler (Zero Adjusted) -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
