<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <DockPanel>
        <!-- Top Menu & Toolbar (ရှိပြီးသား MenuBar ကို မပြောင်းလဲဘဲ ထားပါ) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="22">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area (Gray Background background color #808080) -->
        <Grid x:Name="MdiHostGrid" Background="#808080">
            <!-- Dynamic Child Windows များကို Code-Behind မှ ဤနေရာသို့ ထည့်သွင်းမည်ဖြစ်သည် -->
        </Grid>
    </DockPanel>
</Window>
