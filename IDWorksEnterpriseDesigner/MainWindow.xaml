                                            <TextBlock Text="0" Canvas.Left="15" Canvas.Top="2" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            <Line X1="12" Y1="18" X2="12" Y2="24" Stroke="Black" StrokeThickness="1"/>
                                            <Line X1="30.9" Y1="19" X2="30.9" Y2="24" Stroke="Black" StrokeThickness="0.75"/>
                                            <TextBlock Text="1" Canvas.Left="52" Canvas.Top="2" FontSize="9" Foreground="Black"/>
                                            <Line X1="49.8" Y1="18" X2="49.8" Y2="24" Stroke="Black" StrokeThickness="1"/>
