<Window x:Class="IDWorksEnterpriseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <!-- File Menu (Updated for Disabled Recent File on Start) -->
            <MenuItem Header="_File">
                <MenuItem Header="New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="Open Project..." InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="MenuCloseProject" Header="Close Project" Visibility="Collapsed"/>
                <Separator x:Name="Sep1" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuSaveProject" Header="Save Project" InputGestureText="Ctrl+S" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuSaveProjectAs" Header="Save Project As..." Visibility="Collapsed"/>
                <Separator x:Name="Sep2" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuProjectProperties" Header="Project Properties..." InputGestureText="F7" Visibility="Collapsed"/>
                <Separator x:Name="Sep3" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuPrintSampleCard" Header="Print Sample Card..." InputGestureText="Ctrl+P" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuPreviewSampleReport" Header="Preview Sample Report..." IsEnabled="False" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuReportPageSetup" Header="Report Page Setup..." IsEnabled="False" Visibility="Collapsed"/>
                <Separator x:Name="Sep4" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuDeleteProject" Header="Delete Project" Visibility="Collapsed"/>
                <Separator/>
                <!-- Initial Recent File (Disabled) -->
                <MenuItem x:Name="MenuRecentFile" Header="Recent File" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>

            <!-- Other Menu Items (Initially Hidden) -->
            <MenuItem x:Name="MenuEdit" Header="_Edit" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuView" Header="_View"/>
            <MenuItem x:Name="MenuInsert" Header="_Insert" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuFormat" Header="F_ormat" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuTools" Header="_Tools" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuWindow" Header="_Window" Visibility="Collapsed"/>
            <MenuItem x:Name="MenuHelp" Header="_Help"/>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main MDI Workspace Area -->
        <Grid x:Name="MdiHostGrid" Background="#808080">
            <!-- Dynamic MDI Windows will be injected here via C# -->
        </Grid>
    </DockPanel>
</Window>
