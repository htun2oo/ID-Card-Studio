<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Checkable MenuItem Style (တစ်လိုင်းတည်းသာ သပ်ရပ်စွာပေါ်စေရန်) -->
    <Style x:Key="CheckMenuItemStyle" TargetType="MenuItem">
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border" Background="Transparent" Height="22" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" MinWidth="26" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="17"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- ထပ်နေသော ဒေါင်လိုက်မျဉ်းနှစ်လိုင်း မဖြစ်စေရန် Custom Border ကို ဖယ်ရှားပြီးပါပြီ -->

                            <!-- အမှန်ခြစ် (Checkmark) -->
                            <TextBlock x:Name="CheckMark" Grid.Column="0" Text="✓" FontSize="12" FontWeight="Bold" Foreground="Black" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <!-- Header Text -->
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Header}" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E5F3FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio / Dot Style (တစ်လိုင်းတည်းသာ သပ်ရပ်စွာပေါ်စေရန်) -->
    <Style x:Key="RadioMenuItemStyle" TargetType="MenuItem">
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border" Background="Transparent" Height="22" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" MinWidth="26" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="17"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- အစက် (Dot) -->
                            <Ellipse x:Name="BulletMark" Grid.Column="0" Width="5" Height="5" Fill="Black" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <!-- Header Text -->
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Header}" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BulletMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E5F3FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
