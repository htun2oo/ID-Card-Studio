<Window x:Class="IDWorksEnterpriseDesigner.Views.SaveProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save As" Height="150" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>

        <!-- Project Name GroupBox -->
        <GroupBox Header="Project Name" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" Height="70">
            <TextBox x:Name="ProjectNameTextBox" Text="Untitled-1" VerticalAlignment="Center" Margin="6" Padding="2"/>
        </GroupBox>

        <!-- OK and Cancel Buttons -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" Width="80" Height="26" Margin="0,0,0,8"/>
            <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click" Width="80" Height="26"/>
        </StackPanel>
    </Grid>
</Window>
