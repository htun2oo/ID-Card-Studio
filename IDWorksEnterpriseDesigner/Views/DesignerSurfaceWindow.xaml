<UserControl x:Class="IDWorksEnterpriseDesigner.Views.DesignerWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#707070">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Top-Left: Card Window (Front) -->
        <Border Grid.Row="0" Grid.Column="0" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                
                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal Ruler -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="0" FontSize="9" FontWeight="Bold" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="1" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="2" Text="2" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="3" Text="3" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="4" Text="4" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="5" Text="5" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="6" Text="6" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="7" Text="7" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="8" Text="8" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Left Vertical Ruler -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="0" FontSize="9" FontWeight="Bold" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="1" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="2" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="3" Text="3" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="4" Text="4" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="5" Text="5" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Main Workspace Area -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                <Canvas x:Name="CardFrontCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 2. Bottom-Left: Card (back side) Window -->
        <Border Grid.Row="1" Grid.Column="0" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>

                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal Ruler -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="0" FontSize="9" FontWeight="Bold" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="1" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="2" Text="2" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="3" Text="3" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="4" Text="4" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="5" Text="5" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="6" Text="6" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="7" Text="7" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="8" Text="8" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Left Vertical Ruler -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="0" FontSize="9" FontWeight="Bold" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="1" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="2" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="3" Text="3" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="4" Text="4" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="5" Text="5" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                <Canvas x:Name="CardBackCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 3. Top-Right: Production Form Window -->
        <Border Grid.Row="0" Grid.Column="1" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Grid Background="White"/>
            </DockPanel>
        </Border>

        <!-- 4. Bottom-Right: Report Window -->
        <Border Grid.Row="1" Grid.Column="1" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Report" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                
                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal Ruler for Report -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="37.8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="0" FontSize="9" FontWeight="Bold" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="1" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="2" Text="2" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="3" Text="3" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="4" Text="4" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="5" Text="5" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="6" Text="6" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="7" Text="7" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="8" Text="8" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="9" Text="9" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="10" Text="10" FontSize="9" Foreground="Black" Margin="2,4,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Left Vertical Ruler for Report -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="37.8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="0" FontSize="9" FontWeight="Bold" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="1" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="2" FontSize="9" Foreground="Black" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- Main Workspace Area -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="450" Height="150" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
