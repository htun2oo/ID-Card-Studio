<UserControl x:Class="IDWorksEnterpriseDesigner.Views.Components.CardCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:IDWorksEnterpriseDesigner.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#E6E6E6">
        <!-- Grid Structure ခွဲခြင်း -->
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/> <!-- Top Horizontal Ruler -->
            <RowDefinition Height="*"/>  <!-- Main Content Workspace -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/> <!-- Left Vertical Ruler -->
            <ColumnDefinition Width="*"/>  <!-- Main Content Workspace -->
        </Grid.ColumnDefinitions>

        <!-- 1. Top-Left Corner Box -->
        <Border Grid.Row="0" Grid.Column="0" 
                Background="#F0F0F0" 
                BorderBrush="#C0C0C0" 
                BorderThickness="0,0,1,1"/>

        <!-- 2. Horizontal (Top) Ruler -->
        <helpers:RulerControl Grid.Row="0" Grid.Column="1" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"/>

        <!-- 3. Vertical (Left) Ruler -->
        <helpers:RulerControl Grid.Row="1" Grid.Column="0" 
                              Orientation="Vertical" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"/>

        <!-- 4. Card Design Workspace / Canvas -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="#D6D6D6">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border Width="323" Height="204" 
                        Background="White" 
                        BorderBrush="#000000" 
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Color="Gray" Opacity="0.4"/>
                    </Border.Effect>

                    <!-- သင်၏ မူလ Card Canvas Elements များ တည်ရှိရာ နေရာ -->
                    <Canvas x:Name="DesignCanvas">
                        <!-- Existing Items/Controls -->
                    </Canvas>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
