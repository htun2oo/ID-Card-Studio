<UserControl x:Class="IDWorksEnterpriseDesigner.Views.Components.CardCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IDWorksEnterpriseDesigner.Helpers">

    <Grid Background="#E6E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-Left Corner -->
        <Border Grid.Row="0" Grid.Column="0" Background="#D0D0D0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

        <!-- Top Horizontal CM Ruler -->
        <helpers:RulerControl Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Height="20"/>

        <!-- Left Vertical CM Ruler -->
        <helpers:RulerControl Grid.Row="1" Grid.Column="0" Orientation="Vertical" Width="20"/>

        <!-- Card Main Design Workspace Area -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                    <Canvas x:Name="DesignCanvas"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
