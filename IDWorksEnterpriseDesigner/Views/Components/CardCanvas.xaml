<UserControl x:Class="IDWorksEnterpriseDesigner.Views.Components.CardCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:IDWorksEnterpriseDesigner.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#E6E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/> <!-- Horizontal Ruler Area -->
            <RowDefinition Height="*"/>  <!-- Main Workspace -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/> <!-- Vertical Ruler Area -->
            <ColumnDefinition Width="*"/>  <!-- Main Workspace -->
        </Grid.ColumnDefinitions>

        <!-- Top-Left Corner Box -->
        <Border Grid.Row="0" Grid.Column="0" 
                Background="#E0E0E0" 
                BorderBrush="#B0B0B0" 
                BorderThickness="0,0,1,1"/>

        <!-- Top Horizontal CM Ruler -->
        <helpers:RulerControl Grid.Row="0" Grid.Column="1" 
                              Height="20"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Orientation="Horizontal"/>

        <!-- Left Vertical CM Ruler -->
        <helpers:RulerControl Grid.Row="1" Grid.Column="0" 
                              Width="20"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Orientation="Vertical"/>

        <!-- Main Card Canvas Workspace -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="#D6D6D6">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                <Border Width="323" Height="204" 
                        Background="White" 
                        BorderBrush="#000000" 
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="Gray" Opacity="0.3"/>
                    </Border.Effect>

                    <Canvas x:Name="DesignCanvas">
                        <!-- Existing Controls/Elements -->
                    </Canvas>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
