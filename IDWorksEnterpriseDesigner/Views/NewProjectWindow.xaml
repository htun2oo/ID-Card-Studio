<Window x:Class="IDWorksEnterpriseDesigner.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" Height="300" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side Options -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <!-- Project Name Section -->
            <TextBlock Text="Project Name:" Margin="0,0,0,4" FontSize="11"/>
            <TextBox x:Name="TxtProjectName" Height="22" VerticalContentAlignment="Center" Background="White" BorderBrush="#7A9E9F" Margin="0,0,0,12"/>

            <!-- Initial Components GroupBox -->
            <GroupBox Header="Initial Components" Padding="8,6" FontSize="11">
                <StackPanel>
                    <CheckBox x:Name="ChkProductionForm" Content="Production Form Design" IsChecked="True" Margin="0,2"/>
                    
                    <CheckBox x:Name="ChkCardDesign" Content="Card Design" IsChecked="True" Margin="0,4,0,2"/>
                    
                    <!-- Card Design Sub-options -->
                    <StackPanel Margin="18,2,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Width="16" Height="10" BorderBrush="Gray" BorderThickness="1" Background="White" Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbLandscape" Content="Landscape" IsChecked="True" GroupName="CardOrientation"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Border Width="10" Height="16" BorderBrush="Gray" BorderThickness="1" Background="White" Margin="3,0,11,0"/>
                            <RadioButton x:Name="RbPortrait" Content="Portrait" GroupName="CardOrientation"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkMultiCard" Content="Allow for more than one card design&#10;(data-driven card production)" Foreground="Gray" IsEnabled="False" Margin="0,6,0,0"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkReportDesign" Content="Report Design" IsChecked="True" Margin="0,4,0,2"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Right Side Action Buttons -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,18,0,0">
            <Button x:Name="BtnOK" Content="OK" Height="23" Margin="0,0,0,6" IsDefault="True" Click="BtnOK_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Height="23" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
