<Window x:Class="IDWorksEnterpriseDesigner.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDWorksEnterpriseDesigner.Views"
        mc:Ignorable="d"
        Title="New Project" Height="345" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F0F0">
    <Window.Resources>
        <!-- Windows Style Standard Rounded Buttons -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="BorderBrush" Value="#0078D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5F1FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left Main Content Area (TextBox နှင့် GroupBox ကြား အကွာအဝေးကို အနည်းဆုံးဖြစ်အောင် နီးကပ်ထားပါသည်) -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
            <!-- Project Name Label -->
            <TextBlock Text="Project Name:" Margin="0,0,0,0" Foreground="#000000" FontSize="12"/>
            
            <!-- Project Name TextBox -->
            <TextBox x:Name="ProjectNameTextBox" Height="23" VerticalContentAlignment="Center" BorderBrush="#0078D7" Background="White" Margin="0,1,0,0"/>

            <!-- Initial Components GroupBox (TextBox ၏ အောက်တွင် တိုက်ရိုက်ကပ်၍ နီးကပ်စွာ ရွှေ့ထားပါသည်) -->
            <GroupBox Header="Initial Components" Padding="10,6,10,10" Margin="0,4,0,0" BorderBrush="#B5C4D5">
                <StackPanel>
                    <CheckBox x:Name="ProductionFormCheckBox" Content="Production Form Design" IsChecked="True" Margin="0,2,0,6"/>
                    
                    <CheckBox x:Name="CardCheckBox" Content="Card Design" IsChecked="True" Checked="CardCheckBox_CheckedChanged" Unchecked="CardCheckBox_CheckedChanged" Margin="0,2,0,4"/>
                    
                    <StackPanel Margin="22,0,0,6">
                        <!-- Landscape Option with Icon -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Width="15" Height="10" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="OrientationGroup" IsChecked="True" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Portrait Option with Icon -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="10" Height="15" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,11,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="OrientationGroup" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Multi-card CheckBox -->
                        <CheckBox x:Name="MultiCardCheckBox" Content="Allow for more than one card design&#x0a;(data-driven card production)" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Report Design CheckBox -->
                    <CheckBox x:Name="ReportCheckBox" Content="Report Design" IsChecked="False" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- OK and Cancel Buttons (Top-Right stacked) -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource DialogButtonStyle}" Margin="0,0,0,5" 
                    Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DialogButtonStyle}" BorderBrush="#CCCCCC" 
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
