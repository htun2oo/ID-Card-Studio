<Window x:Class="IDWorksEnterpriseDesigner.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDWorksEnterpriseDesigner.Views"
        mc:Ignorable="d"
        Title="New Project" Height="365" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Project Name Section (Top-Left) -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,12">
            <TextBlock Text="Project Name:" Margin="0,0,0,4"/>
            <TextBox x:Name="ProjectNameTextBox" Height="23" VerticalContentAlignment="Center" BorderBrush="#0078D7"/>
        </StackPanel>

        <!-- Buttons Section (Top-Right Stacked) -->
        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0">
            <Button x:Name="OkButton" Content="OK" Width="75" Height="23" Margin="0,0,0,4" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="75" Height="23" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <!-- Initial Components Section -->
        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Initial Components" Padding="10,6,10,10" Margin="0,0,0,0">
            <StackPanel>
                <CheckBox x:Name="ProductionFormCheckBox" Content="Production Form Design" IsChecked="True" Margin="0,2,0,6"/>
                
                <CheckBox x:Name="CardCheckBox" Content="Card Design" IsChecked="True" Checked="CardCheckBox_CheckedChanged" Unchecked="CardCheckBox_CheckedChanged" Margin="0,2,0,4"/>
                
                <StackPanel Margin="22,0,0,6">
                    <!-- Landscape Option with Icon -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Width="15" Height="10" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="OrientationGroup" IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Portrait Option with Icon -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="10" Height="15" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,11,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="OrientationGroup" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Multi-card CheckBox -->
                    <CheckBox x:Name="MultiCardCheckBox" Content="Allow for more than one card design&#x0a;(data-driven card production)" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Report Design CheckBox unchecked -->
                <CheckBox x:Name="ReportCheckBox" Content="Report Design" IsChecked="False" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
