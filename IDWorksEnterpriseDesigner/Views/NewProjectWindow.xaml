<Window x:Class="IDWorksEnterpriseDesigner.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Project" Height="285" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Project Name Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Project Name:" Margin="0,0,0,4"/>
            <TextBox x:Name="ProjectNameTextBox" Height="24" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Buttons Column (Right side) -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="75">
            <Button Content="OK" IsDefault="True" Height="24" Margin="0,0,0,6" Click="OkButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Height="24" Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Initial Components GroupBox -->
        <GroupBox Grid.Row="1" Header="Initial Components" Padding="8" Margin="0,0,85,0">
            <StackPanel>
                <CheckBox x:Name="ProdFormCheckBox" Content="Production Form Design" IsChecked="True" Margin="0,0,0,6"/>
                
                <!-- Card Design with Custom Icon Options -->
                <CheckBox x:Name="CardCheckBox" Content="Card Design" IsChecked="True" Margin="0,0,0,4" Checked="CardCheckBox_CheckedChanged" Unchecked="CardCheckBox_CheckedChanged"/>
                
                <StackPanel Margin="18,0,0,6">
                    <!-- Landscape Option with Icon -->
                    <DockPanel Margin="0,0,0,4">
                        <Border Width="16" Height="10" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="LandscapeRadio" Content="Landscape" IsChecked="True"/>
                    </DockPanel>
                    
                    <!-- Portrait Option with Icon -->
                    <DockPanel Margin="0,0,0,4">
                        <Border Width="10" Height="16" BorderBrush="Black" BorderThickness="1" Background="White" Margin="3,0,9,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="PortraitRadio" Content="Portrait"/>
                    </DockPanel>
                    
                    <CheckBox x:Name="MultiCardCheckBox" Content="Allow for more than one card design&#x0a;(data-driven card production)" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Report Design positioned correctly at the bottom -->
                <CheckBox x:Name="ReportCheckBox" Content="Report Design" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
