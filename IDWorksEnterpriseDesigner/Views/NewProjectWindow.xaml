<Window x:Class="IDWorksEnterpriseDesigner.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" Height="320" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="85"/>
        </Grid.ColumnDefinitions>

        <!-- Top Section: Project Name Input -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Project Name:" Margin="0,0,0,4" FontSize="12"/>
            <TextBox x:Name="TxtProjectName" Height="23"/>
        </StackPanel>

        <!-- Right Section: OK and Cancel Buttons -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,18,0,0">
            <Button Content="OK" Height="23" Margin="0,0,0,8" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Height="23" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <!-- GroupBox: Initial Components -->
        <GroupBox Header="Initial Components" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <StackPanel Margin="10,6,10,6">
                <CheckBox Content="Production Form Design" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkCardDesign" Content="Card Design" IsChecked="False" 
                          Checked="ChkCardDesign_Checked" Unchecked="ChkCardDesign_Unchecked"/>
                
                <!-- Card Options Sub-section -->
                <StackPanel Margin="20,6,0,6">
                    <!-- Landscape Option -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="18" Height="12" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,12,0"/>
                        <RadioButton x:Name="RbLandscape" Content="Landscape" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Portrait Option -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="12" Height="18" BorderBrush="Black" BorderThickness="1" Background="White" Margin="3,0,15,0"/>
                        <RadioButton x:Name="RbPortrait" Content="Portrait" IsEnabled="False" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Allow Multiple Card Design Checkbox -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="ChkAllowMultiple" IsEnabled="False" Margin="0,2,6,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtAllowMultiple" IsEnabled="False" FontSize="11" Foreground="#555555" 
                                   Text="Allow for more than one card design&#10;(data-driven card production)"/>
                    </StackPanel>
                </StackPanel>

                <CheckBox Content="Report Design" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
