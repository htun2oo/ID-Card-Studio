<Window x:Class="IDWorksEnterpriseDesigner.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDWorksEnterpriseDesigner.Views"
        mc:Ignorable="d"
        Title="New Project" Height="370" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="12,12,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Project Name Label (Row 0) -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" Margin="0,0,0,4" Foreground="#000000" FontSize="12"/>

        <!-- Project Name TextBox (Row 1, Column 0) -->
        <TextBox x:Name="ProjectNameTextBox" Grid.Row="1" Grid.Column="0" Height="23" VerticalContentAlignment="Center" BorderBrush="#0078D7" Background="White" Margin="0,0,12,0"/>

        <!-- OK and Cancel Buttons (Row 1, Column 1 - Aligned perfectly with TextBox top) -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
            <Button x:Name="OkButton" Content="OK" Width="76" Height="23" Margin="0,0,0,6" 
                    Click="OkButton_Click" IsDefault="True"
                    Background="#E1E1E1" BorderBrush="#0078D7" BorderThickness="1"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="76" Height="23" 
                    Click="CancelButton_Click" IsCancel="True"
                    Background="#E1E1E1" BorderBrush="#707070" BorderThickness="1"/>
        </StackPanel>

        <!-- Initial Components Section (Row 2, Column 0 - Width matches TextBox exactly) -->
        <GroupBox Grid.Row="2" Grid.Column="0" Header="Initial Components" Padding="10,6,10,10" Margin="0,12,0,0" BorderBrush="#B5C4D5">
            <StackPanel>
                <CheckBox x:Name="ProductionFormCheckBox" Content="Production Form Design" IsChecked="True" Margin="0,2,0,6"/>
                
                <CheckBox x:Name="CardCheckBox" Content="Card Design" IsChecked="True" Checked="CardCheckBox_CheckedChanged" Unchecked="CardCheckBox_CheckedChanged" Margin="0,2,0,4"/>
                
                <StackPanel Margin="22,0,0,6">
                    <!-- Landscape Option with Icon -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Width="15" Height="10" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="OrientationGroup" IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Portrait Option with Icon -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="10" Height="15" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,11,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="OrientationGroup" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Multi-card CheckBox -->
                    <CheckBox x:Name="MultiCardCheckBox" Content="Allow for more than one card design&#x0a;(data-driven card production)" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Report Design CheckBox -->
                <CheckBox x:Name="ReportCheckBox" Content="Report Design" IsChecked="False" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
