<UserControl x:Class="IDWorksEnterpriseDesigner.Views.DesignerWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#707070">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Top-Left: Card Window (Photoshop-style Centimeter Rulers ထည့်သွင်းထားသည်) -->
        <Border Grid.Row="0" Grid.Column="0" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                
                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal CM Ruler (1 cm = ~37.8 pixels) -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Canvas ClipToBounds="True">
                            <TextBlock Text="0" Canvas.Left="2" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="37.8" Y1="12" X2="37.8" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="39.8" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="75.6" Y1="12" X2="75.6" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="2" Canvas.Left="77.6" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="113.4" Y1="12" X2="113.4" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="3" Canvas.Left="115.4" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="151.2" Y1="12" X2="151.2" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="4" Canvas.Left="153.2" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="189.0" Y1="12" X2="189.0" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="5" Canvas.Left="191.0" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="226.8" Y1="12" X2="226.8" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="6" Canvas.Left="228.8" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="264.6" Y1="12" X2="264.6" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="7" Canvas.Left="266.6" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="302.4" Y1="12" X2="302.4" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="8" Canvas.Left="304.4" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                        </Canvas>
                    </Border>

                    <!-- Left Vertical CM Ruler -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Canvas ClipToBounds="True">
                            <TextBlock Text="0" Canvas.Left="2" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="37.8" X2="20" Y2="37.8" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="2" Canvas.Top="38.8" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="75.6" X2="20" Y2="75.6" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="2" Canvas.Left="2" Canvas.Top="76.6" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="113.4" X2="20" Y2="113.4" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="3" Canvas.Left="2" Canvas.Top="114.4" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="151.2" X2="20" Y2="151.2" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="4" Canvas.Left="2" Canvas.Top="152.2" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="189.0" X2="20" Y2="189.0" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="5" Canvas.Left="2" Canvas.Top="191.0" FontSize="8" Foreground="#333"/>
                        </Canvas>
                    </Border>

                    <!-- Main Workspace Area -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                <Canvas x:Name="CardFrontCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 2. Bottom-Left: Card (back side) Window (Photoshop-style Centimeter Rulers ထည့်သွင်းထားသည်) -->
        <Border Grid.Row="1" Grid.Column="0" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>

                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal CM Ruler -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Canvas ClipToBounds="True">
                            <TextBlock Text="0" Canvas.Left="2" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="37.8" Y1="12" X2="37.8" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="39.8" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="75.6" Y1="12" X2="75.6" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="2" Canvas.Left="77.6" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="113.4" Y1="12" X2="113.4" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="3" Canvas.Left="115.4" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="151.2" Y1="12" X2="151.2" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="4" Canvas.Left="153.2" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="189.0" Y1="12" X2="189.0" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="5" Canvas.Left="191.0" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="226.8" Y1="12" X2="226.8" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="6" Canvas.Left="228.8" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="264.6" Y1="12" X2="264.6" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="7" Canvas.Left="266.6" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="302.4" Y1="12" X2="302.4" Y2="20" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="8" Canvas.Left="304.4" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                        </Canvas>
                    </Border>

                    <!-- Left Vertical CM Ruler -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Canvas ClipToBounds="True">
                            <TextBlock Text="0" Canvas.Left="2" Canvas.Top="1" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="37.8" X2="20" Y2="37.8" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="1" Canvas.Left="2" Canvas.Top="38.8" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="75.6" X2="20" Y2="75.6" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="2" Canvas.Left="2" Canvas.Top="76.6" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="113.4" X2="20" Y2="113.4" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="3" Canvas.Left="2" Canvas.Top="115.4" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="151.2" X2="20" Y2="151.2" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="4" Canvas.Left="2" Canvas.Top="153.2" FontSize="8" Foreground="#333"/>
                            <Line X1="12" Y1="189.0" X2="20" Y2="189.0" Stroke="#555" StrokeThickness="1"/>
                            <TextBlock Text="5" Canvas.Left="2" Canvas.Top="191.0" FontSize="8" Foreground="#333"/>
                        </Canvas>
                    </Border>

                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                <Canvas x:Name="CardBackCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 3. Top-Right: Production Form Window (မူလအတိုင်း) -->
        <Border Grid.Row="0" Grid.Column="1" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Grid Background="White"/>
            </DockPanel>
        </Border>

        <!-- 4. Bottom-Right: Report Window (မူလအတိုင်း) -->
        <Border Grid.Row="1" Grid.Column="1" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Report" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Grid Background="#D6D6D6">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="450" Height="150" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
