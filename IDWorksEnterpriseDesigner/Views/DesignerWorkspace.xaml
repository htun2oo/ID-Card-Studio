<UserControl x:Class="IDWorksEnterpriseDesigner.Views.DesignerWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#707070">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Top-Left: Card Window -->
        <Border Grid.Row="0" Grid.Column="0" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                
                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal Ruler (cm scale) -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <!-- 0 cm to 10 cm (1 cm = 37.8 pixels) -->
                                <TextBlock Text="0" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="1" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="2" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="3" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="4" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="5" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="6" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="7" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                                <TextBlock Text="8" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2" TextAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Left Vertical Ruler (cm scale) -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="0" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="1" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="2" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="3" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="4" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="5" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Workspace Area -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                <Canvas x:Name="CardFrontCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 2. Bottom-Left: Card (back side) Window -->
        <Border Grid.Row="1" Grid.Column="0" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>

                <Grid Background="#E6E6E6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Corner Box -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,1"/>

                    <!-- Top Horizontal Ruler -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <TextBlock Text="0" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="1" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="2" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="3" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="4" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="5" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="6" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="7" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                                <TextBlock Text="8" Width="37.8" FontSize="8" Foreground="#333" Padding="2,0,0,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Left Vertical Ruler -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,0,1,0">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="0" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="1" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="2" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="3" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="4" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                                <TextBlock Text="5" Height="37.8" FontSize="8" Foreground="#333" Padding="2,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D6D6D6">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="323" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                <Canvas x:Name="CardBackCanvas"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 3. Top-Right: Production Form Window -->
        <Border Grid.Row="0" Grid.Column="1" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Grid Background="White"/>
            </DockPanel>
        </Border>

        <!-- 4. Bottom-Right: Report Window -->
        <Border Grid.Row="1" Grid.Column="1" Margin="2" Background="#C0C0C0" BorderBrush="#909090" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1D2A78" Height="22" Padding="5,2">
                    <TextBlock Text="Report" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Grid Background="#D6D6D6">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <Border Width="450" Height="150" Background="White" BorderBrush="#000000" BorderThickness="1"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
